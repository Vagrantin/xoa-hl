# xo-server currently runs as root. These exact commands preserve the least-
# privilege boundary if it is de-rooted later.
xo-server ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block xoa-hl-update.service
xo-server ALL=(root) NOPASSWD: /usr/bin/systemctl start xoa-hl-check-update.service
xo-server ALL=(root) NOPASSWD: /usr/libexec/xoa-hl/configure-updates.sh *
