+// -------------------------------------------------------------------
+// Helper functions
+// -------------------------------------------------------------------
+
+function parseMemory(memString) {
+  if (!memString) return 0
+  const match = memString.match(/^([\d.]+)(B|KB|MB|GB|TB)/i)
+  if (!match) return 0
+  
+  const value = parseFloat(match[1])
+  const unit = match[2].toUpperCase()
+  
+  const units = { B: 1, KB: 1024, MB: 1024 * 1024, GB: 1024 * 1024 * 1024, TB: 1024 * 1024 * 1024 * 1024 }
+  return value * (units[unit] || 1)
+}
+
+function formatMemory(bytes) {
+  if (bytes === 0) return '0'
+  
+  const units = ['B', 'KB', 'MB', 'GB', 'TB']
+  let value = bytes
+  let unitIndex = 0
+  
+  while (value >= 1024 && unitIndex < units.length - 1) {
+    value /= 1024
+    unitIndex++
+  }
+  
+  return `${Math.round(value)}${units[unitIndex]}`
+}
+
+async function saveContainerConfig(name, config) {
+  try {
+    await execa('mkdir', ['-p', CONTAINER_CONFIG_DIR])
+    const configPath = join(CONTAINER_CONFIG_DIR, `${name}.json`)
+    await writeFile(configPath, JSON.stringify(config, null, 2))
+  } catch {
+    // Non-fatal
+  }
+}
+
+async function removeContainerConfig(name) {
+  try {
+    const configPath = join(CONTAINER_CONFIG_DIR, `${name}.json`)
+    await unlink(configPath)
+  } catch {
+    // Non-fatal
+  }
+}
