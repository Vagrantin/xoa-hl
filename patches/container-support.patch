--- /dev/null
+++ b/packages/xo-server/src/containers.mjs
@@ -0,0 +1,227 @@
+// Dedicated Docker VM protocol v1. The appliance never executes Docker locally.
+import { execFile, spawn } from 'node:child_process'
+import { mkdir, mkdtemp, readFile, readdir, rm, writeFile } from 'node:fs/promises'
+import { isIP } from 'node:net'
+import { join } from 'node:path'
+import { promisify } from 'node:util'
+
+const exec = promisify(execFile)
+export const TEMPLATE_TAG = 'xcp-hl-docker-template-v1'
+export const HOST_TAG = 'xcp-hl-docker-v1'
+export const ROOT = '/var/lib/xoa-hl/docker-hosts'
+const KEY_TAG = 'xcp-hl-docker-key:'
+
+export function validateDeployment({ name, cpus, memoryMiB }) {
+  if (typeof name !== 'string' || !/^[\w .-]{1,63}$/.test(name)) throw new Error('Invalid VM name')
+  if (!Number.isInteger(cpus) || cpus < 1 || cpus > 32) throw new Error('Choose 1–32 vCPUs')
+  if (!Number.isInteger(memoryMiB) || memoryMiB < 1024 || memoryMiB > 131072)
+    throw new Error('Choose 1024–131072 MiB RAM')
+}
+
+export function credentialId(vm) {
+  if (!vm.tags?.includes(HOST_TAG)) throw new Error('Not an XOA-HL Docker VM')
+  const id = vm.tags.find(tag => tag.startsWith(KEY_TAG))?.slice(KEY_TAG.length)
+  if (id === undefined || !/^host-[a-zA-Z0-9]{6}$/.test(id)) throw new Error('Missing Docker VM credentials')
+  return id
+}
+
+export async function prepareCredentials(root = ROOT, administratorKey = '') {
+  if (typeof administratorKey !== 'string' || administratorKey.length > 8192 || /[\r\n]/.test(administratorKey))
+    throw new Error('Provide one SSH public key for guest maintenance')
+  administratorKey = administratorKey.trim()
+  if (
+    administratorKey !== '' &&
+    !/^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(?:256|384|521)) [A-Za-z0-9+/=]+(?: [^\r\n]*)?$/.test(administratorKey)
+  )
+    throw new Error('Invalid administrator SSH public key')
+  await mkdir(root, { recursive: true, mode: 0o700 })
+  const directory = await mkdtemp(join(root, 'host-'))
+  try {
+    for (const key of ['client', 'host']) {
+      await exec(
+        '/usr/bin/ssh-keygen',
+        ['-q', '-t', 'ed25519', '-N', '', '-C', 'xoa-hl-docker', '-f', join(directory, key)],
+        { timeout: 10000 }
+      )
+    }
+    if (administratorKey !== '') {
+      await writeFile(join(directory, 'administrator.pub'), administratorKey + '\n', { mode: 0o600 })
+      try {
+        await exec('/usr/bin/ssh-keygen', ['-l', '-f', join(directory, 'administrator.pub')], { timeout: 10000 })
+      } catch (_) {
+        throw new Error('Invalid administrator SSH public key')
+      }
+    }
+    const client = (await readFile(join(directory, 'client.pub'), 'utf8')).trim()
+    const hostPublic = (await readFile(join(directory, 'host.pub'), 'utf8')).trim()
+    const hostPrivate = await readFile(join(directory, 'host'), 'utf8')
+    const users = [
+      {
+        name: 'root',
+        lock_passwd: true,
+        ssh_authorized_keys: ['restrict,command="/usr/local/libexec/xoa-hl-docker-command" ' + client],
+      },
+    ]
+    if (administratorKey !== '')
+      users.push({
+        name: 'docker-admin',
+        lock_passwd: true,
+        shell: '/bin/bash',
+        sudo: 'ALL=(ALL) NOPASSWD:ALL',
+        ssh_authorized_keys: [administratorKey],
+      })
+    const cloudConfig =
+      '#cloud-config\n' +
+      JSON.stringify({
+        disable_root: false,
+        ssh_pwauth: false,
+        ssh_deletekeys: false,
+        ssh_keys: { ed25519_private: hostPrivate, ed25519_public: hostPublic },
+        users,
+        write_files: [
+          {
+            path: '/etc/ssh/sshd_config.d/01-xoa-hl-docker.conf',
+            permissions: '0600',
+            content:
+              'PermitRootLogin forced-commands-only\nPasswordAuthentication no\nKbdInteractiveAuthentication no\n',
+          },
+        ],
+        runcmd: [
+          ['systemctl', 'restart', 'sshd'],
+          ['systemctl', 'start', 'docker'],
+        ],
+      })
+    // Pin the identity, independent of DHCP changes; no TOFU and no global known_hosts.
+    await writeFile(join(directory, 'known_hosts'), 'docker-host ' + hostPublic + '\n', { mode: 0o600 })
+    await rm(join(directory, 'host')) // Private host key now exists only in the temporary cloud-init seed.
+    return { directory, tag: KEY_TAG + directory.split('/').pop(), cloudConfig }
+  } catch (error) {
+    await rm(directory, { recursive: true, force: true })
+    throw error
+  }
+}
+
+export function sshArguments(directory, address) {
+  if (
+    isIP(address) === 0 ||
+    address.startsWith('127.') ||
+    address === '::1' ||
+    address === '0.0.0.0' ||
+    address.startsWith('169.254.')
+  ) {
+    throw new Error('Invalid guest management address')
+  }
+  return [
+    '-F',
+    '/dev/null',
+    '-T',
+    '-i',
+    join(directory, 'client'),
+    '-o',
+    'BatchMode=yes',
+    '-o',
+    'IdentitiesOnly=yes',
+    '-o',
+    'StrictHostKeyChecking=yes',
+    '-o',
+    'GlobalKnownHostsFile=/dev/null',
+    '-o',
+    'UserKnownHostsFile=' + join(directory, 'known_hosts'),
+    '-o',
+    'HostKeyAlias=docker-host',
+    '-o',
+    'ConnectTimeout=5',
+    '-o',
+    'ConnectionAttempts=1',
+    '-o',
+    'ServerAliveInterval=10',
+    '-o',
+    'ServerAliveCountMax=2',
+    '-o',
+    'ClearAllForwardings=yes',
+    '-o',
+    'LogLevel=ERROR',
+    '--',
+    'root@' + address,
+    '/usr/local/libexec/xoa-hl-docker-command',
+  ]
+}
+
+export function guestAddress(vm) {
+  const addresses = Object.values(vm.addresses ?? {}).flat()
+  const address = addresses.find(address => isIP(address) === 4 && !/^(127\.|169\.254\.|0\.)/.test(address))
+  if (address === undefined)
+    throw new Error('Waiting for guest tools and a DHCP IPv4 address. Check the VM console and network.')
+  return address
+}
+
+const busy = new Set()
+export async function remote(vm, request, { root = ROOT, spawnProcess = spawn } = {}) {
+  if (vm.power_state !== 'Running') throw new Error('Docker VM is not running. Start it from its VM page.')
+  const id = credentialId(vm)
+  if (busy.has(id)) throw new Error('A Docker operation is already running on this VM. Wait and retry.')
+  busy.add(id)
+  try {
+    const directory = join(root, id)
+    try {
+      await readFile(join(directory, 'client'))
+    } catch (_) {
+      throw new Error('Docker VM access keys are missing. Restore the docker-hosts directory from the XOA-HL backup.')
+    }
+    const input = JSON.stringify({ ...request, version: 1 })
+    if (Buffer.byteLength(input) > 65536) throw new Error('Request too large')
+    const args = sshArguments(directory, guestAddress(vm))
+    return await new Promise((resolve, reject) => {
+      const child = spawnProcess('/usr/bin/ssh', args, { stdio: ['pipe', 'pipe', 'ignore'] })
+      let output = Buffer.alloc(0)
+      let failure
+      const timer = setTimeout(() => {
+        failure = new Error('Docker operation timed out')
+        child.kill('SIGKILL')
+      }, 270000)
+      child.stdout.on('data', chunk => {
+        if (failure !== undefined) return
+        output = Buffer.concat([output, chunk])
+        if (output.length > 4 * 1024 * 1024) {
+          failure = new Error('Docker response too large')
+          child.kill('SIGKILL')
+        }
+      })
+      child.on('error', error => {
+        clearTimeout(timer)
+        reject(error)
+      })
+      child.stdin.on('error', () => {})
+      child.on('close', code => {
+        clearTimeout(timer)
+        if (failure !== undefined) return reject(failure)
+        try {
+          const response = JSON.parse(output.toString())
+          if (response.error !== undefined) throw new Error(response.error)
+          if (code !== 0 || response.result === undefined) throw new Error('Invalid Docker host response')
+          resolve(response.result)
+        } catch (error) {
+          reject(
+            code === 255 || output.length === 0
+              ? new Error(
+                  'Docker VM is not ready or SSH identity verification failed. Check cloud-init, network and the VM console; retry when ready.'
+                )
+              : error
+          )
+        }
+      })
+      child.stdin.end(input)
+    })
+  } finally {
+    busy.delete(id)
+  }
+}
+
+export async function availableCredentialIds(root = ROOT) {
+  try {
+    return await readdir(root)
+  } catch (error) {
+    if (error.code === 'ENOENT') return []
+    throw error
+  }
+}
