index 000000000..ac2c97b52
--- /dev/null
+++ b/packages/xo-server/src/api/containers.mjs
@@ -0,0 +1,125 @@
+import { rm } from 'node:fs/promises'
+import { create as createVm } from './vm.mjs'
+import {
+  availableCredentialIds,
+  credentialId,
+  guestAddress,
+  HOST_TAG,
+  prepareCredentials,
+  remote,
+  TEMPLATE_TAG,
+  validateDeployment,
+} from '../containers.mjs'
+
+export async function getHosts() {
+  const keys = new Set(await availableCredentialIds())
+  return Object.values(this.getObjects())
+    .filter(vm => vm.type === 'VM' && vm.tags?.includes(HOST_TAG))
+    .map(vm => {
+      let hasCredentials = false
+      try {
+        hasCredentials = keys.has(credentialId(vm))
+      } catch (_) {}
+      return { id: vm.id, name: vm.name_label, powerState: vm.power_state, hasCredentials }
+    })
+}
+getHosts.permission = 'admin'
+getHosts.params = {}
+
+let deploying = false
+export async function deploy({ template, sr, network, name, cpus, memoryMiB, administratorKey }) {
+  validateDeployment({ name, cpus, memoryMiB })
+  if (!template.tags?.includes(TEMPLATE_TAG))
+    throw new Error('Select the Docker host v1 template built by build-xoa-hl CI')
+  if (template.$pool !== sr.$pool || template.$pool !== network.$pool || sr.content_type === 'iso')
+    throw new Error('Template, writable SR and network must be in the same pool')
+  if (deploying) throw new Error('Another Docker VM deployment is in progress')
+  deploying = true
+  let credentials, vmId
+  try {
+    credentials = await prepareCredentials(undefined, administratorKey)
+    const xapi = this.getXapi(template)
+    const disks = {}
+    for (const vbd of xapi.getObject(template._xapiId).$VBDs) {
+      if (vbd.type === 'Disk' && vbd.$VDI) disks[vbd.userdevice] = { $SR: sr.id }
+    }
+    if (Object.keys(disks).length === 0) throw new Error('Docker template has no installed system disk')
+    // Reuse XO's create path: permissions, full disk copy, VIFs and cloud-init seed.
+    vmId = await createVm.call(this, {
+      template,
+      name_label: name,
+      name_description: 'Dedicated XOA-HL Docker host (protocol v1)',
+      CPUs: cpus,
+      cpusMax: cpus,
+      memory: memoryMiB * 1048576,
+      memoryStaticMax: memoryMiB * 1048576,
+      memoryMin: memoryMiB * 1048576,
+      memoryMax: memoryMiB * 1048576,
+      clone: false,
+      existingDisks: disks,
+      VIFs: [{ network: network.id }],
+      cloudConfig: credentials.cloudConfig,
+      bootAfterCreate: true,
+      destroyCloudConfigVdiAfterBoot: true,
+      tags: [HOST_TAG, credentials.tag],
+    })
+    return { id: vmId }
+  } catch (error) {
+    if (credentials !== undefined && vmId === undefined)
+      await rm(credentials.directory, { recursive: true, force: true })
+    throw error
+  } finally {
+    deploying = false
+  }
+}
+deploy.permission = 'admin'
+deploy.params = {
+  template: { type: 'string' },
+  sr: { type: 'string' },
+  network: { type: 'string' },
+  name: { type: 'string' },
+  administratorKey: { type: 'string', optional: true },
+  cpus: { type: 'integer' },
+  memoryMiB: { type: 'integer' },
+}
+deploy.resolve = {
+  template: ['template', 'VM-template', 'administrate'],
+  sr: ['sr', 'SR', 'administrate'],
+  network: ['network', 'network', 'administrate'],
+}
+
+export async function overview({ vm }) {
+  return { ...(await remote(vm, { operation: 'overview' })), address: guestAddress(vm) }
+}
+export function create({ vm, config }) {
+  return remote(vm, { operation: 'create', config })
+}
+export function start({ vm, id }) {
+  return remote(vm, { operation: 'start', id })
+}
+export function stop({ vm, id }) {
+  return remote(vm, { operation: 'stop', id })
+}
+export function restart({ vm, id }) {
+  return remote(vm, { operation: 'restart', id })
+}
+export function remove({ vm, id }) {
+  return remote(vm, { operation: 'remove', id })
+}
+export function logs({ vm, id }) {
+  return remote(vm, { operation: 'logs', id })
+}
+export function pull({ vm, image }) {
+  return remote(vm, { operation: 'pull', image })
+}
+export function removeImage({ vm, image }) {
+  return remote(vm, { operation: 'removeImage', image })
+}
+for (const fn of [overview, create, start, stop, restart, remove, logs, pull, removeImage]) {
+  fn.permission = 'admin'
+  fn.resolve = { vm: ['vm', 'VM', 'administrate'] }
+  fn.params = { vm: { type: 'string' } }
+}
+create.params.config = { type: 'object', additionalProperties: true }
+for (const fn of [start, stop, restart, remove, logs]) fn.params.id = { type: 'string' }
+for (const fn of [pull, removeImage]) fn.params.image = { type: 'string' }
