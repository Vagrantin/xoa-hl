new file mode 100644
index 000000000..1c72ada4a
--- /dev/null
+++ b/packages/xo-web/src/xo-app/containers/index.js
@@ -0,0 +1,423 @@
+import _ from 'intl'
+import Component from 'base-component'
+import React from 'react'
+import Link from 'link'
+import { confirm } from 'modal'
+import { connectStore } from 'utils'
+import { createGetObjectsOfType, isAdmin } from 'selectors'
+import { containerCall } from 'xo'
+
+const mib = value => Math.round(value / 1048576)
+const percent = (used, total) => (total > 0 ? Math.round((100 * used) / total) + '%' : '—')
+const options = values =>
+  values.map(value => (
+    <option key={value.id} value={value.id}>
+      {value.name_label}
+    </option>
+  ))
+
+@connectStore(() => {
+  const templates = createGetObjectsOfType('VM-template')
+  const vms = createGetObjectsOfType('VM')
+  const srs = createGetObjectsOfType('SR')
+  const networks = createGetObjectsOfType('network')
+  return state => ({
+    admin: isAdmin(state),
+    templates: Object.values(templates(state)).filter(vm => (vm.tags || []).includes('xcp-hl-docker-template-v1')),
+    hosts: Object.values(vms(state)).filter(vm => (vm.tags || []).includes('xcp-hl-docker-v1')),
+    srs: Object.values(srs(state)).filter(sr => sr.content_type !== 'iso'),
+    networks: Object.values(networks(state)),
+  })
+})
+export default class Containers extends Component {
+  state = {
+    vm: '',
+    template: '',
+    sr: '',
+    network: '',
+    vmName: 'Docker',
+    vmCpus: 2,
+    vmMemory: 2048,
+    administratorKey: '',
+    name: '',
+    image: '',
+    cpus: 1,
+    memoryMiB: 256,
+    ports: '',
+    volumes: '',
+    environment: '',
+    restart: 'unless-stopped',
+    pullImage: '',
+    error: '',
+    notice: '',
+    logs: undefined,
+    busy: false,
+    overview: undefined,
+  }
+
+  componentDidMount() {
+    this._active = true
+    this._schedule()
+  }
+  componentWillUnmount() {
+    this._active = false
+    clearTimeout(this._timer)
+  }
+  _schedule = () => {
+    if (this._active) this._timer = setTimeout(this._poll, 5000)
+  }
+  _poll = async () => {
+    await this._refresh()
+    this._schedule()
+  }
+  _refresh = async () => {
+    const { vm, busy } = this.state
+    if (!this.props.admin || !vm || busy || this._pending) return
+    this._pending = true
+    this.setState({ busy: true })
+    try {
+      const overview = await containerCall('overview', { vm })
+      if (this._active && this.state.vm === vm) {
+        const before = this.state.overview?.host.cpuTicks
+        const ticks = overview.host.cpuTicks
+        let cpu = '—'
+        if (before) {
+          const total = ticks.reduce((a, n, i) => a + n - before[i], 0)
+          cpu = percent(total - (ticks[3] - before[3]) - (ticks[4] - before[4]), total)
+        }
+        this.setState({ overview, cpu, error: '' })
+      }
+    } catch (error) {
+      if (this._active && this.state.vm === vm) this.setState({ error: error.message })
+    } finally {
+      this._pending = false
+      if (this._active) this.setState({ busy: false })
+    }
+  }
+  _set = key => event => this.setState({ [key]: event.target.value })
+  _selectHost = event =>
+    this.setState({ vm: event.target.value, overview: undefined, logs: undefined, error: '', cpu: '—' }, this._refresh)
+  _perform = async (operation, params) => {
+    if (this.state.busy || this._pending) return
+    this._pending = true
+    this.setState({ busy: true, error: '', notice: '' })
+    try {
+      const result = await containerCall(operation, params)
+      if (this._active) {
+        if (operation === 'logs') this.setState({ logs: result.logs })
+        if (operation === 'deploy')
+          this.setState({ vm: result.id, overview: undefined, notice: result.warning || _('containersBooting') })
+        else if (operation !== 'logs') this.setState({ notice: _('containersDone') })
+      }
+    } catch (error) {
+      if (this._active) this.setState({ error: error.message })
+    } finally {
+      this._pending = false
+      if (this._active) this.setState({ busy: false })
+    }
+    // Poll will reconcile state after every successful or failed mutation.
+  }
+  _deploy = event => {
+    event.preventDefault()
+    const s = this.state
+    this._perform('deploy', {
+      template: s.template,
+      sr: s.sr,
+      network: s.network,
+      name: s.vmName,
+      cpus: +s.vmCpus,
+      memoryMiB: +s.vmMemory,
+      administratorKey: s.administratorKey,
+    })
+  }
+  _create = event => {
+    event.preventDefault()
+    try {
+      const s = this.state
+      const ports = s.ports
+        .split('\n')
+        .filter(Boolean)
+        .map(line => {
+          const match = /^(\d+):(\d+)(?:\/(tcp|udp))?$/.exec(line.trim())
+          if (!match) throw new Error(_('containersPortsHelp'))
+          return { host: +match[1], container: +match[2], protocol: match[3] || 'tcp' }
+        })
+      const volumes = s.volumes
+        .split('\n')
+        .filter(Boolean)
+        .map(line => {
+          const colon = line.indexOf(':')
+          if (colon < 1) throw new Error(_('containersVolumesHelp'))
+          return { name: line.slice(0, colon).trim(), path: line.slice(colon + 1).trim() }
+        })
+      const environment = {}
+      for (const line of s.environment.split('\n').filter(Boolean)) {
+        const equal = line.indexOf('=')
+        if (equal < 1) throw new Error(_('containersEnvironmentHelp'))
+        environment[line.slice(0, equal).trim()] = line.slice(equal + 1)
+      }
+      this._perform('create', {
+        vm: s.vm,
+        config: {
+          name: s.name,
+          image: s.image,
+          cpus: +s.cpus,
+          memoryMiB: +s.memoryMiB,
+          ports,
+          volumes,
+          environment,
+          restart: s.restart,
+        },
+      })
+    } catch (error) {
+      this.setState({ error: error.message })
+    }
+  }
+  _remove = async (operation, params) => {
+    try {
+      await confirm({ title: _('containersRemove'), body: _('containersRemoveWarning') })
+    } catch (_) {
+      return
+    }
+    this._perform(operation, params)
+  }
+  _input(key, title, type = 'text', attrs = {}) {
+    return (
+      <label className='m-r-1'>
+        {title}
+        <input className='form-control' type={type} value={this.state[key]} onChange={this._set(key)} {...attrs} />
+      </label>
+    )
+  }
+  _select(key, title, values, onChange = this._set(key)) {
+    return (
+      <label className='m-r-1'>
+        {title}
+        <select
+          className='form-control'
+          required
+          disabled={this.state.busy}
+          value={this.state[key]}
+          onChange={onChange}
+        >
+          <option value=''>{_('containersChoose')}</option>
+          {options(values)}
+        </select>
+      </label>
+    )
+  }
+  render() {
+    if (!this.props.admin) return <p className='alert alert-danger'>{_('containersAdminOnly')}</p>
+    const s = this.state
+    const data = s.overview
+    const template = this.props.templates.find(t => t.id === s.template)
+    const pool = template?.$pool
+    return (
+      <main className='container-fluid p-a-1'>
+        <h2>{_('containersPage')}</h2>
+        <p>{_('containersIntroduction')}</p>
+        {s.error && (
+          <p role='alert' className='alert alert-danger'>
+            {s.error}
+          </p>
+        )}
+        {s.notice && (
+          <p role='status' className='alert alert-info'>
+            {s.notice}
+          </p>
+        )}
+        {s.busy && <p role='status'>{_('containersWorking')}</p>}
+        <details>
+          <summary>{_('containersDeployVm')}</summary>
+          {this.props.templates.length === 0 && <p className='alert alert-warning'>{_('containersTemplateHelp')}</p>}
+          <form onSubmit={this._deploy}>
+            <fieldset disabled={s.busy}>
+              {this._select('template', _('containersTemplate'), this.props.templates, e =>
+                this.setState({ template: e.target.value, sr: '', network: '' })
+              )}
+              {this._select(
+                'sr',
+                _('containersStorage'),
+                this.props.srs.filter(sr => sr.$pool === pool)
+              )}
+              {this._select(
+                'network',
+                _('containersNetwork'),
+                this.props.networks.filter(n => n.$pool === pool)
+              )}
+              {this._input('vmName', _('containersName'), 'text', { required: true, maxLength: 63 })}
+              {this._input('vmCpus', _('containersCpus'), 'number', { required: true, min: 1, max: 32 })}
+              {this._input('vmMemory', _('containersMemoryLimit'), 'number', {
+                required: true,
+                min: 1024,
+                max: 131072,
+              })}
+              {this._input('administratorKey', _('containersAdministratorKey'), 'text', { maxLength: 8192 })}
+              <p>{_('containersDeploymentHelp')}</p>
+              <button className='btn btn-primary' type='submit'>
+                {_('containersDeployVm')}
+              </button>
+            </fieldset>
+          </form>
+        </details>
+        <hr />
+        {this._select('vm', _('containersHost'), this.props.hosts, this._selectHost)}
+        <button disabled={s.busy || !s.vm} className='btn btn-secondary' onClick={this._refresh}>
+          {_('containersRefresh')}
+        </button>
+        {s.vm && (
+          <Link className='m-l-1' to={'/vms/' + s.vm}>
+            {_('containersVmDetails')}
+          </Link>
+        )}
+        {data && (
+          <section aria-label={_('containersResources')}>
+            <h3>{_('containersResources')}</h3>
+            <p>
+              {_('containersHost')}: {data.address}
+            </p>
+            <p>
+              {_('containersCpu')}: {s.cpu} / {data.host.cpus} vCPU · {_('containersMemory')}:{' '}
+              {mib(data.host.memoryUsed)} / {mib(data.host.memoryTotal)} MiB (
+              {percent(data.host.memoryUsed, data.host.memoryTotal)}) · {_('containersDisk')}: {mib(data.host.diskUsed)}{' '}
+              / {mib(data.host.diskTotal)} MiB · Docker {data.host.dockerVersion}
+            </p>
+            <fieldset disabled={s.busy || !!s.error}>
+              <h3>{_('containersCreate')}</h3>
+              <form onSubmit={this._create}>
+                {this._input('name', _('containersName'), 'text', {
+                  required: true,
+                  pattern: '[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}',
+                })}
+                {this._input('image', _('containersImage'), 'text', { required: true })}
+                {this._input('cpus', _('containersCpus'), 'number', {
+                  required: true,
+                  min: 0.1,
+                  step: 0.1,
+                  max: data.host.cpus,
+                })}
+                {this._input('memoryMiB', _('containersMemoryLimit'), 'number', {
+                  required: true,
+                  min: 16,
+                  max: Math.max(16, mib(data.host.memoryTotal) - 256),
+                })}
+                <details>
+                  <summary>{_('containersAdvanced')}</summary>
+                  {['ports', 'volumes', 'environment'].map(key => (
+                    <label className='d-block' key={key}>
+                      {_('containers' + key[0].toUpperCase() + key.slice(1) + 'Help')}
+                      <textarea className='form-control' rows='3' value={s[key]} onChange={this._set(key)} />
+                    </label>
+                  ))}
+                  <label>
+                    {_('containersRestartPolicy')}
+                    <select className='form-control' value={s.restart} onChange={this._set('restart')}>
+                      {['no', 'on-failure', 'always', 'unless-stopped'].map(v => (
+                        <option key={v}>{v}</option>
+                      ))}
+                    </select>
+                  </label>
+                </details>
+                <p>{_('containersPullFirst')}</p>
+                <button className='btn btn-primary' type='submit'>
+                  {_('containersCreate')}
+                </button>
+              </form>
+              <h3>{_('containersList')}</h3>
+              <table className='table'>
+                <thead>
+                  <tr>
+                    {['Name', 'Image', 'Status', 'Ports', 'Cpu', 'Memory', 'Actions'].map(k => (
+                      <th key={k}>{_('containers' + k)}</th>
+                    ))}
+                  </tr>
+                </thead>
+                <tbody>
+                  {data.containers.map(c => {
+                    const stat = data.stats.find(v => v.ID === c.ID || v.Container === c.ID) || {}
+                    return (
+                      <tr key={c.ID}>
+                        <td>{c.Names}</td>
+                        <td>{c.Image}</td>
+                        <td>{c.Status}</td>
+                        <td>{c.Ports}</td>
+                        <td>{stat.CPUPerc || '—'}</td>
+                        <td>{stat.MemUsage || '—'}</td>
+                        <td>
+                          {['start', 'stop', 'restart', 'logs', 'remove'].map(op => (
+                            <button
+                              type='button'
+                              className='btn btn-sm btn-secondary m-r-1'
+                              key={op}
+                              onClick={() =>
+                                op === 'remove'
+                                  ? this._remove(op, { vm: s.vm, id: c.ID })
+                                  : this._perform(op, { vm: s.vm, id: c.ID })
+                              }
+                            >
+                              {_('containers' + op[0].toUpperCase() + op.slice(1))}
+                            </button>
+                          ))}
+                        </td>
+                      </tr>
+                    )
+                  })}
+                </tbody>
+              </table>
+              {data.containers.length === 0 && <p>{_('containersEmpty')}</p>}
+              <h3>{_('containersImages')}</h3>
+              <form
+                onSubmit={e => {
+                  e.preventDefault()
+                  this._perform('pull', { vm: s.vm, image: s.pullImage })
+                }}
+              >
+                {this._input('pullImage', _('containersImage'), 'text', { required: true })}
+                <button className='btn btn-primary' type='submit'>
+                  {_('containersPull')}
+                </button>
+              </form>
+              <table className='table'>
+                <thead>
+                  <tr>
+                    <th>{_('containersImage')}</th>
+                    <th>{_('containersDisk')}</th>
+                    <th>{_('containersActions')}</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {data.images.map((image, i) => (
+                    <tr key={i}>
+                      <td>
+                        {image.Repository}:{image.Tag}
+                      </td>
+                      <td>{image.Size}</td>
+                      <td>
+                        <button
+                          className='btn btn-secondary'
+                          onClick={() => this._remove('removeImage', { vm: s.vm, image: image.ID })}
+                        >
+                          {_('containersRemove')}
+                        </button>
+                      </td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </fieldset>
+          </section>
+        )}
+        {s.logs !== undefined && (
+          <section>
+            <h3>{_('containersLogs')}</h3>
+            <p>{_('containersLogHelp')}</p>
+            <pre style={{ maxHeight: '24rem', overflow: 'auto' }}>{s.logs}</pre>
+            <button className='btn btn-secondary' onClick={() => this.setState({ logs: undefined })}>
+              {_('containersClose')}
+            </button>
+          </section>
+        )}
+      </main>
+    )
+  }
+}
