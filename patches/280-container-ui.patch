diff --git a/packages/xo-web/src/xo-app/containers/dashboard-card.js b/packages/xo-web/src/xo-app/containers/dashboard-card.js
new file mode 100644
index 000000000..0519eaaed
--- /dev/null
+++ b/packages/xo-web/src/xo-app/containers/dashboard-card.js
@@ -0,0 +1,103 @@
+import _ from 'intl'
+import Component from 'base-component'
+import Icon from 'icon'
+import React from 'react'
+import Link from 'link'
+import { Card, CardBlock, CardHeader } from 'card'
+import { containerCall } from 'xo'
+
+const mib = value => Math.round(value / 1048576)
+const ratio = (used, total) => (total > 0 ? used / total : 0)
+const level = value => (value >= 0.9 ? 'text-danger' : value >= 0.75 ? 'text-warning' : undefined)
+
+// Dashboard summary of every Docker VM. Renders nothing until one exists.
+export default class DockerCard extends Component {
+  state = { summary: undefined }
+
+  componentDidMount() {
+    this._active = true
+    this._load()
+  }
+  componentWillUnmount() {
+    this._active = false
+    clearTimeout(this._timer)
+  }
+  _load = async () => {
+    try {
+      const summary = await containerCall('summary')
+      if (this._active) this.setState({ summary })
+    } catch (_) {
+      // The dashboard stays usable when the summary is unavailable.
+    }
+    if (this._active) this._timer = setTimeout(this._load, 30000)
+  }
+  _renderHost = host => {
+    if (host.powerState !== 'Running' || host.error !== undefined) {
+      return (
+        <tr key={host.id}>
+          <td>
+            <Link to={'/vms/' + host.id}>{host.name}</Link>
+          </td>
+          <td colSpan={5} className='text-warning'>
+            <Icon icon='alarm' /> {host.error || _('containersVmStopped')}
+          </td>
+        </tr>
+      )
+    }
+    const total = mib(host.memoryTotal)
+    const reserved = Math.max(ratio(host.cpusAllocated, host.cpus), ratio(host.memoryAllocatedMiB, total))
+    return (
+      <tr key={host.id}>
+        <td>
+          <Link to={'/vms/' + host.id}>{host.name}</Link>
+        </td>
+        <td>
+          {host.running} / {host.containers}
+          {host.downloads > 0 && <span className='text-info'> · {_('containersDownloadRunning')}</span>}
+          {host.failedDownloads > 0 && <span className='text-danger'> · {_('containersDownloadFailed')}</span>}
+        </td>
+        <td>{Math.round((100 * host.load) / host.cpus)}%</td>
+        <td className={level(ratio(host.memoryUsed, host.memoryTotal))}>
+          {mib(host.memoryUsed)} / {total} MiB
+        </td>
+        <td className={level(ratio(host.diskUsed, host.diskTotal))}>
+          {Math.round(100 * ratio(host.diskUsed, host.diskTotal))}%
+        </td>
+        <td className={reserved > 1 ? 'text-warning' : undefined}>
+          {host.cpusAllocated} / {host.cpus} vCPU · {host.memoryAllocatedMiB} / {total} MiB
+        </td>
+      </tr>
+    )
+  }
+  render() {
+    const { summary } = this.state
+    if (summary === undefined || summary.hosts.length === 0) return null
+    const up = summary.hosts.filter(host => host.containers !== undefined)
+    const sum = key => up.reduce((total, host) => total + host[key], 0)
+    return (
+      <Card>
+        <CardHeader>
+          <Icon icon='vm' /> <Link to='/containers'>{_('containersDashboard')}</Link>
+        </CardHeader>
+        <CardBlock>
+          <p className='text-xs-center'>
+            <strong>
+              {sum('running')} / {sum('containers')}
+            </strong>{' '}
+            {_('containersDashboardRunning')} · {up.length} / {summary.hosts.length} {_('containersDashboardVms')}
+          </p>
+          <table className='table'>
+            <thead>
+              <tr>
+                {['Host', 'List', 'Load', 'Memory', 'Disk', 'Reserved'].map(key => (
+                  <th key={key}>{_('containers' + key)}</th>
+                ))}
+              </tr>
+            </thead>
+            <tbody>{summary.hosts.map(this._renderHost)}</tbody>
+          </table>
+        </CardBlock>
+      </Card>
+    )
+  }
+}
diff --git a/packages/xo-web/src/xo-app/containers/index.js b/packages/xo-web/src/xo-app/containers/index.js
new file mode 100644
index 000000000..b09264444
--- /dev/null
+++ b/packages/xo-web/src/xo-app/containers/index.js
@@ -0,0 +1,604 @@
+import _ from 'intl'
+import Component from 'base-component'
+import Icon from 'icon'
+import React from 'react'
+import Link from 'link'
+import { Card, CardBlock, CardHeader } from 'card'
+import { Col, Container, Row } from 'grid'
+import { confirm } from 'modal'
+import { connectStore } from 'utils'
+import { createGetObjectsOfType, isAdmin } from 'selectors'
+import { containerCall } from 'xo'
+
+const mib = value => Math.round(value / 1048576)
+const percent = (used, total) => (total > 0 ? Math.round((100 * used) / total) + '%' : '—')
+const options = values =>
+  values.map(value => (
+    <option key={value.id} value={value.id}>
+      {value.name_label}
+    </option>
+  ))
+const only = values => (values.length === 1 ? values[0].id : '')
+
+@connectStore(() => {
+  const templates = createGetObjectsOfType('VM-template')
+  const vms = createGetObjectsOfType('VM')
+  const srs = createGetObjectsOfType('SR')
+  const networks = createGetObjectsOfType('network')
+  const pools = createGetObjectsOfType('pool')
+  return state => ({
+    admin: isAdmin(state),
+    templates: Object.values(templates(state)).filter(vm => (vm.tags || []).includes('xcp-hl-docker-template-v1')),
+    hosts: Object.values(vms(state)).filter(vm => (vm.tags || []).includes('xcp-hl-docker-v1')),
+    srs: Object.values(srs(state)).filter(sr => sr.content_type !== 'iso'),
+    networks: Object.values(networks(state)),
+    pools: Object.values(pools(state)),
+  })
+})
+export default class Containers extends Component {
+  state = {
+    vm: '',
+    template: '',
+    sr: '',
+    network: '',
+    vmName: 'Docker',
+    vmCpus: 2,
+    vmMemory: 2048,
+    administratorKey: '',
+    name: '',
+    image: '',
+    cpus: 1,
+    memoryMiB: 256,
+    ports: '',
+    volumes: '',
+    environment: '',
+    restart: 'unless-stopped',
+    pullImage: '',
+    error: '',
+    unreachable: '',
+    notice: '',
+    logs: undefined,
+    busy: false,
+    overview: undefined,
+    orphans: [],
+  }
+
+  componentDidMount() {
+    this._active = true
+    this._refresh()
+    this._loadOrphans()
+    this._schedule()
+  }
+  componentWillUnmount() {
+    this._active = false
+    clearTimeout(this._timer)
+  }
+  _schedule = () => {
+    if (this._active) this._timer = setTimeout(this._poll, 5000)
+  }
+  _poll = async () => {
+    await this._refresh()
+    this._schedule()
+  }
+  // A single Docker VM, template, storage or network needs no choice from the user.
+  _vm = () => this.state.vm || only(this.props.hosts)
+  _placement = () => {
+    const { props, state } = this
+    const template = state.template || only(props.templates)
+    const poolId = (props.templates.find(t => t.id === template) || {}).$pool
+    const pool = props.pools.find(p => p.id === poolId) || {}
+    const srs = props.srs.filter(sr => sr.$pool === poolId)
+    const networks = props.networks.filter(n => n.$pool === poolId)
+    return {
+      template,
+      srs,
+      networks,
+      sr: state.sr || (srs.some(sr => sr.id === pool.default_SR) ? pool.default_SR : only(srs)),
+      network: state.network || only(networks),
+    }
+  }
+  // Background refresh never disables the forms; mutations wait for it.
+  _refresh = () => {
+    if (this._polling === undefined) {
+      this._polling = this._load().then(() => {
+        this._polling = undefined
+      })
+    }
+    return this._polling
+  }
+  _load = async () => {
+    const vm = this._vm()
+    if (!this.props.admin || !vm || this._acting) return
+    try {
+      const overview = await containerCall('overview', { vm })
+      if (this._active && this._vm() === vm) {
+        const before = this.state.overview?.host.cpuTicks
+        const ticks = overview.host.cpuTicks
+        let cpu = '—'
+        if (before) {
+          const total = ticks.reduce((a, n, i) => a + n - before[i], 0)
+          cpu = percent(total - (ticks[3] - before[3]) - (ticks[4] - before[4]), total)
+        }
+        this.setState({ overview, cpu, unreachable: '' })
+      }
+    } catch (error) {
+      if (this._active && this._vm() === vm) this.setState({ unreachable: error.message })
+    }
+  }
+  _loadOrphans = async () => {
+    if (!this.props.admin) return
+    try {
+      const { orphans } = await containerCall('summary')
+      if (this._active) this.setState({ orphans: orphans || [] })
+    } catch (_) {}
+  }
+  _set = key => event => this.setState({ [key]: event.target.value })
+  _selectHost = event =>
+    this.setState(
+      { vm: event.target.value, overview: undefined, logs: undefined, error: '', unreachable: '', cpu: '—' },
+      this._refresh
+    )
+  _perform = async (operation, params) => {
+    if (this._acting) return
+    this._acting = true
+    this.setState({ busy: true, error: '', notice: '' })
+    try {
+      // The guest accepts one operation at a time.
+      await this._polling
+      const result = await containerCall(operation, params)
+      if (this._active) {
+        if (operation === 'logs') this.setState({ logs: result.logs })
+        else if (operation === 'deploy')
+          this.setState({ vm: result.id, overview: undefined, notice: _('containersBooting') })
+        else if (result.task !== undefined) this.setState({ notice: _('containersDownloading') })
+        else this.setState({ notice: _('containersDone') })
+        if (operation === 'create' && result.task === undefined) this.setState({ name: '' })
+      }
+    } catch (error) {
+      if (this._active) this.setState({ error: error.message })
+    } finally {
+      this._acting = false
+      if (this._active) this.setState({ busy: false })
+    }
+    if (operation === 'forgetCredentials') this._loadOrphans()
+    else if (operation !== 'deploy') this._refresh()
+  }
+  _deploy = event => {
+    event.preventDefault()
+    const s = this.state
+    const { template, sr, network } = this._placement()
+    this._perform('deploy', {
+      template,
+      sr,
+      network,
+      name: s.vmName,
+      cpus: +s.vmCpus,
+      memoryMiB: +s.vmMemory,
+      administratorKey: s.administratorKey,
+    })
+  }
+  _create = event => {
+    event.preventDefault()
+    try {
+      const s = this.state
+      const ports = s.ports
+        .split('\n')
+        .filter(Boolean)
+        .map(line => {
+          const match = /^(\d+):(\d+)(?:\/(tcp|udp))?$/.exec(line.trim())
+          if (!match) throw new Error(_('containersPortsHelp'))
+          return { host: +match[1], container: +match[2], protocol: match[3] || 'tcp' }
+        })
+      const volumes = s.volumes
+        .split('\n')
+        .filter(Boolean)
+        .map(line => {
+          const colon = line.indexOf(':')
+          if (colon < 1) throw new Error(_('containersVolumesHelp'))
+          return { name: line.slice(0, colon).trim(), path: line.slice(colon + 1).trim() }
+        })
+      const environment = {}
+      for (const line of s.environment.split('\n').filter(Boolean)) {
+        const equal = line.indexOf('=')
+        if (equal < 1) throw new Error(_('containersEnvironmentHelp'))
+        environment[line.slice(0, equal).trim()] = line.slice(equal + 1)
+      }
+      this._perform('create', {
+        vm: this._vm(),
+        config: {
+          name: s.name,
+          image: s.image.trim(),
+          cpus: +s.cpus,
+          memoryMiB: +s.memoryMiB,
+          ports,
+          volumes,
+          environment,
+          restart: s.restart,
+        },
+      })
+    } catch (error) {
+      this.setState({ error: error.message })
+    }
+  }
+  _remove = async (operation, params, warning = 'containersRemoveWarning') => {
+    try {
+      await confirm({ title: _('containersRemove'), body: _(warning) })
+    } catch (_) {
+      return
+    }
+    this._perform(operation, params)
+  }
+  _input(key, title, type = 'text', attrs = {}) {
+    return (
+      <label className='m-r-1'>
+        {title}
+        <input className='form-control' type={type} value={this.state[key]} onChange={this._set(key)} {...attrs} />
+      </label>
+    )
+  }
+  _select(key, title, values, value, onChange = this._set(key)) {
+    return (
+      <label className='m-r-1'>
+        {title}
+        <select className='form-control' required value={value} onChange={onChange}>
+          <option value=''>{_('containersChoose')}</option>
+          {options(values)}
+        </select>
+      </label>
+    )
+  }
+  _card(icon, title, body) {
+    return (
+      <Row>
+        <Col>
+          <Card>
+            <CardHeader>
+              <Icon icon={icon} /> {title}
+            </CardHeader>
+            <CardBlock>{body}</CardBlock>
+          </Card>
+        </Col>
+      </Row>
+    )
+  }
+  _renderDeploy() {
+    const { props, state: s } = this
+    const placement = this._placement()
+    return (
+      <form onSubmit={this._deploy}>
+        <fieldset disabled={s.busy}>
+          {props.templates.length > 1 &&
+            this._select('template', _('containersTemplate'), props.templates, placement.template, e =>
+              this.setState({ template: e.target.value, sr: '', network: '' })
+            )}
+          {this._input('vmName', _('containersName'), 'text', { required: true, maxLength: 63 })}
+          {this._input('vmCpus', _('containersVmCpus'), 'number', { required: true, min: 1, max: 32 })}
+          {this._input('vmMemory', _('containersVmMemory'), 'number', { required: true, min: 1024, max: 131072 })}
+          {this._select('sr', _('containersStorage'), placement.srs, placement.sr)}
+          {this._select('network', _('containersNetwork'), placement.networks, placement.network)}
+          <details>
+            <summary>{_('containersAdvanced')}</summary>
+            {this._input('administratorKey', _('containersAdministratorKey'), 'text', { maxLength: 8192 })}
+          </details>
+          <p className='text-muted'>{_('containersDeploymentHelp')}</p>
+          <button className='btn btn-primary' type='submit'>
+            <Icon icon='add' /> {_('containersDeployVm')}
+          </button>
+        </fieldset>
+      </form>
+    )
+  }
+  _renderResources(data) {
+    const host = data.host
+    const total = mib(host.memoryTotal)
+    const over = host.cpusAllocated > host.cpus || host.memoryAllocatedMiB > total
+    return (
+      <div>
+        <Row>
+          <Col mediumSize={3}>
+            <strong>{_('containersCpu')}</strong>
+            <br />
+            {this.state.cpu} · {host.cpus} vCPU
+          </Col>
+          <Col mediumSize={3}>
+            <strong>{_('containersMemory')}</strong>
+            <br />
+            {mib(host.memoryUsed)} / {total} MiB ({percent(host.memoryUsed, host.memoryTotal)})
+          </Col>
+          <Col mediumSize={3}>
+            <strong>{_('containersDisk')}</strong>
+            <br />
+            {mib(host.diskUsed)} / {mib(host.diskTotal)} MiB ({percent(host.diskUsed, host.diskTotal)})
+          </Col>
+          <Col mediumSize={3}>
+            <strong>{_('containersReserved')}</strong>
+            <br />
+            <span className={over ? 'text-warning' : undefined}>
+              {host.cpusAllocated} / {host.cpus} vCPU · {host.memoryAllocatedMiB} / {total} MiB
+            </span>
+          </Col>
+        </Row>
+        <p className='text-muted m-t-1'>
+          {_(over ? 'containersOvercommitted' : 'containersReservedHelp')} · {data.address} · Docker{' '}
+          {host.dockerVersion}
+        </p>
+      </div>
+    )
+  }
+  _renderCreate(data) {
+    const s = this.state
+    return (
+      <form onSubmit={this._create}>
+        {this._input('name', _('containersName'), 'text', {
+          required: true,
+          pattern: '[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}',
+          placeholder: 'web',
+        })}
+        {this._input('image', _('containersImage'), 'text', { required: true, placeholder: 'nginx:alpine' })}
+        {this._input('cpus', _('containersCpus'), 'number', {
+          required: true,
+          min: 0.1,
+          step: 0.1,
+          max: data.host.cpus,
+        })}
+        {this._input('memoryMiB', _('containersMemoryLimit'), 'number', {
+          required: true,
+          min: 16,
+          max: Math.max(16, mib(data.host.memoryTotal) - 256),
+        })}
+        <details>
+          <summary>{_('containersAdvanced')}</summary>
+          {['ports', 'volumes', 'environment'].map(key => (
+            <label className='d-block' key={key}>
+              {_('containers' + key[0].toUpperCase() + key.slice(1) + 'Help')}
+              <textarea className='form-control' rows='3' value={s[key]} onChange={this._set(key)} />
+            </label>
+          ))}
+          <label>
+            {_('containersRestartPolicy')}
+            <select className='form-control' value={s.restart} onChange={this._set('restart')}>
+              {['no', 'on-failure', 'always', 'unless-stopped'].map(v => (
+                <option key={v}>{v}</option>
+              ))}
+            </select>
+          </label>
+        </details>
+        <p className='text-muted'>{_('containersCreateHelp')}</p>
+        <button className='btn btn-primary' type='submit'>
+          <Icon icon='add' /> {_('containersCreate')}
+        </button>
+      </form>
+    )
+  }
+  _renderTasks(data, vm) {
+    return (data.tasks || []).map(task => (
+      <p key={task.id} role='status' className={'alert alert-' + (task.state === 'failed' ? 'danger' : 'info')}>
+        {_(task.state === 'failed' ? 'containersDownloadFailed' : 'containersDownloadRunning')}: {task.image}
+        {task.name && ' → ' + task.name}
+        {task.state === 'failed' && ' · ' + task.error}{' '}
+        {task.state === 'failed' && (
+          <button
+            type='button'
+            className='btn btn-sm btn-secondary'
+            onClick={() => this._perform('dismiss', { vm, id: task.id })}
+          >
+            {_('containersDismiss')}
+          </button>
+        )}
+      </p>
+    ))
+  }
+  _renderContainers(data, vm) {
+    return (
+      <div>
+        <table className='table'>
+          <thead>
+            <tr>
+              {['Name', 'Image', 'Status', 'Ports', 'Cpu', 'Memory', 'Actions'].map(k => (
+                <th key={k}>{_('containers' + k)}</th>
+              ))}
+            </tr>
+          </thead>
+          <tbody>
+            {data.containers.map(c => {
+              const stat = data.stats.find(v => v.ID === c.ID || v.Container === c.ID) || {}
+              const limit = (data.limits || {})[c.ID] || {}
+              const running = c.State === 'running'
+              return (
+                <tr key={c.ID}>
+                  <td>{c.Names}</td>
+                  <td>{c.Image}</td>
+                  <td>
+                    <span className={running ? 'text-success' : 'text-muted'}>
+                      <Icon icon={running ? 'running' : 'halted'} />
+                    </span>{' '}
+                    {c.Status}
+                  </td>
+                  <td>{c.Ports}</td>
+                  <td>
+                    {stat.CPUPerc || '—'} / {limit.cpus} CPU
+                  </td>
+                  <td>{stat.MemUsage || '— / ' + limit.memoryMiB + 'MiB'}</td>
+                  <td>
+                    {(running ? ['stop', 'restart', 'logs'] : ['start', 'logs', 'remove']).map(op => (
+                      <button
+                        type='button'
+                        className='btn btn-sm btn-secondary m-r-1'
+                        key={op}
+                        onClick={() =>
+                          op === 'remove' ? this._remove(op, { vm, id: c.ID }) : this._perform(op, { vm, id: c.ID })
+                        }
+                      >
+                        {_('containers' + op[0].toUpperCase() + op.slice(1))}
+                      </button>
+                    ))}
+                  </td>
+                </tr>
+              )
+            })}
+          </tbody>
+        </table>
+        {data.containers.length === 0 && <p>{_('containersEmpty')}</p>}
+      </div>
+    )
+  }
+  _renderImages(data, vm) {
+    return (
+      <div>
+        <form
+          onSubmit={e => {
+            e.preventDefault()
+            this._perform('pull', { vm, image: this.state.pullImage.trim() })
+          }}
+        >
+          {this._input('pullImage', _('containersImage'), 'text', { required: true })}
+          <button className='btn btn-secondary' type='submit'>
+            {_('containersPull')}
+          </button>
+        </form>
+        <p className='text-muted'>{_('containersPullHelp')}</p>
+        <table className='table'>
+          <thead>
+            <tr>
+              <th>{_('containersImage')}</th>
+              <th>{_('containersDisk')}</th>
+              <th>{_('containersActions')}</th>
+            </tr>
+          </thead>
+          <tbody>
+            {data.images.map((image, i) => (
+              <tr key={i}>
+                <td>
+                  {image.Repository}:{image.Tag}
+                </td>
+                <td>{image.Size}</td>
+                <td>
+                  <button
+                    type='button'
+                    className='btn btn-sm btn-secondary'
+                    onClick={() => this._remove('removeImage', { vm, image: image.ID })}
+                  >
+                    {_('containersRemove')}
+                  </button>
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      </div>
+    )
+  }
+  render() {
+    const { props, state: s } = this
+    if (!props.admin) return <p className='alert alert-danger'>{_('containersAdminOnly')}</p>
+    const data = s.overview
+    const vm = this._vm()
+    const noTemplate = props.templates.length === 0
+    return (
+      <Container>
+        <h2>
+          <Icon icon='vm' /> {_('containersPage')}
+        </h2>
+        <p>{_('containersIntroduction')}</p>
+        {s.error && (
+          <p role='alert' className='alert alert-danger'>
+            {s.error}
+          </p>
+        )}
+        {s.notice && (
+          <p role='status' className='alert alert-info'>
+            {s.notice}
+          </p>
+        )}
+        {props.hosts.length === 0 &&
+          this._card(
+            'info',
+            _('containersGetStarted'),
+            <ol>
+              <li className={noTemplate ? undefined : 'text-muted'}>{_('containersTemplateHelp')}</li>
+              <li>{_('containersStepDeploy')}</li>
+              <li>{_('containersStepRun')}</li>
+            </ol>
+          )}
+        {this._card(
+          'vm',
+          _('containersHost'),
+          <div>
+            {props.hosts.length > 1 && this._select('vm', _('containersHost'), props.hosts, vm, this._selectHost)}
+            {vm && (
+              <span>
+                <button type='button' disabled={s.busy} className='btn btn-secondary' onClick={this._refresh}>
+                  <Icon icon='refresh' /> {_('containersRefresh')}
+                </button>
+                <Link className='m-l-1' to={'/vms/' + vm}>
+                  {_('containersVmDetails')}
+                </Link>
+              </span>
+            )}
+            {s.unreachable && (
+              <p role='alert' className='alert alert-warning m-t-1'>
+                {s.unreachable}
+              </p>
+            )}
+            {data && this._renderResources(data)}
+            {noTemplate ? (
+              props.hosts.length > 0 && <p className='text-muted m-t-1'>{_('containersTemplateHelp')}</p>
+            ) : (
+              <details className='m-t-1' open={props.hosts.length === 0}>
+                <summary>{_('containersDeployVm')}</summary>
+                {this._renderDeploy()}
+              </details>
+            )}
+          </div>
+        )}
+        {data && (
+          <fieldset disabled={s.busy || !!s.unreachable}>
+            {this._card('add', _('containersCreate'), this._renderCreate(data))}
+            {this._card(
+              'vm',
+              _('containersList'),
+              <div>
+                {this._renderTasks(data, vm)}
+                {this._renderContainers(data, vm)}
+              </div>
+            )}
+            {this._card('disk', _('containersImages'), this._renderImages(data, vm))}
+          </fieldset>
+        )}
+        {s.logs !== undefined &&
+          this._card(
+            'logs',
+            _('containersLogs'),
+            <div>
+              <p>{_('containersLogHelp')}</p>
+              <pre style={{ maxHeight: '24rem', overflow: 'auto' }}>{s.logs}</pre>
+              <button type='button' className='btn btn-secondary' onClick={() => this.setState({ logs: undefined })}>
+                {_('containersClose')}
+              </button>
+            </div>
+          )}
+        {s.orphans.length > 0 &&
+          this._card(
+            'alarm',
+            _('containersOrphans'),
+            <div>
+              <p>{_('containersOrphansHelp')}</p>
+              {s.orphans.map(id => (
+                <p key={id}>
+                  <code>{id}</code>{' '}
+                  <button
+                    type='button'
+                    disabled={s.busy}
+                    className='btn btn-sm btn-secondary'
+                    onClick={() => this._remove('forgetCredentials', { id }, 'containersOrphansWarning')}
+                  >
+                    {_('containersRemove')}
+                  </button>
+                </p>
+              ))}
+            </div>
+          )}
+      </Container>
+    )
+  }
+}
