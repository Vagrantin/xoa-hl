+export async function getVmVersion() {
+  try {
+    return (await readFile('/etc/xoa-hl-vm-release', 'utf8')).trim()
+  } catch (error) {
+    // image built before the release stamp existed
+    return { error: 'unknown' }
+  }
+}
+getVmVersion.permission = 'admin'
+getVmVersion.description = 'get the version of the xoa-hl appliance image'
