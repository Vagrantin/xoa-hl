--- /dev/null
+++ b/packages/xo-server/src/_xoaHlAccounts.mjs
@@ -0,0 +1,48 @@
+import { readFile } from 'node:fs/promises'
+
+export const DEFAULT_ADMIN = { email: 'admin@admin.net', password: 'admin' }
+
+const decode = value => Buffer.from(value, 'base64').toString('utf8')
+
+// Root-only file written by the XOA-HL first boot, before networking starts (xcp-hl#389).
+export async function readDeploymentAccount(read = readFile, path = '/etc/xoa-first-boot.env') {
+  const content = await read(path, 'utf8').catch(error => {
+    if (error.code !== 'ENOENT') throw error
+  })
+  if (content === undefined) return
+  const values = Object.fromEntries(
+    content
+      .split('\n')
+      .map(line => /^(XOA_EMAIL|XOA_PASSWORD)=([A-Za-z0-9+/=]+)$/.exec(line))
+      .filter(match => match !== null)
+      .map(([, key, value]) => [key, decode(value)])
+  )
+  if (!values.XOA_EMAIL || !values.XOA_PASSWORD) return
+  return { email: values.XOA_EMAIL, password: values.XOA_PASSWORD }
+}
+
+// XOA-HL images carry this stamp; other installations keep the upstream behaviour.
+export async function isXoaHlImage(read = readFile, path = '/etc/xoa-hl-vm-release') {
+  return read(path, 'utf8').then(
+    () => true,
+    error => {
+      if (error.code !== 'ENOENT') throw error
+      return false
+    }
+  )
+}
+
+// First account of an empty database; undefined means create none.
+export async function chooseFirstAccount({ fromXenStore, fromDeployment, onImage }) {
+  const { email, password } = (await fromXenStore()) ?? {}
+  if (email && password) return { email, password }
+  const deployment = await fromDeployment()
+  if (deployment !== undefined) return deployment
+  if (await onImage()) return
+  return { email: email ?? DEFAULT_ADMIN.email, password: password ?? DEFAULT_ADMIN.password }
+}
+
+// True when an imported user still has the well-known default credentials (xcp-hl#388).
+export async function isDefaultAdmin({ email, pw_hash: pwHash }, verify) {
+  return email === DEFAULT_ADMIN.email && pwHash !== undefined && (await verify(DEFAULT_ADMIN.password, pwHash))
+}
