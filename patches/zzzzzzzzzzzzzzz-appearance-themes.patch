+}
+:root[data-xhl-theme="alpine"][data-xhl-scheme="dark"] {
+  --xhl-bg: #131d19;
+  --xhl-panel: #1d2b24;
+  --xhl-soft: #23332a;
+  --xhl-ink: #e5eee7;
+  --xhl-muted: #a7b9aa;
+  --xhl-border: #3c4e41;
+  --xhl-accent: #9bd4ae;
+  --xhl-tint: #2c4234;
+  --xhl-on-accent: #152e20;
+  --xhl-side: #18271f;
+  --xhl-side-ink: #bbcebd;
+  --xhl-side-muted: #a4bca7;
+  --xhl-active: #304c38;
+  --xhl-active-ink: #bbdfbd;
+  --xhl-ok: #a4d6a8;
+  --xhl-ok-bg: #30442e;
+  --xhl-off: #adb9a9;
+  --xhl-off-bg: #374237;
+}
+:root[data-xhl-theme="horizon"][data-xhl-scheme="light"] {
+  --xhl-bg: #f0f0fa;
+  --xhl-panel: #ffffff;
+  --xhl-soft: #f7f7fc;
+  --xhl-ink: #282747;
+  --xhl-muted: #62617e;
+  --xhl-border: #deddf0;
+  --xhl-accent: #6854d6;
+  --xhl-tint: #f0edff;
+  --xhl-on-accent: #ffffff;
+  --xhl-side: #20213d;
+  --xhl-side-ink: #d2d2e6;
+  --xhl-side-muted: #b1b0cc;
+  --xhl-active: #3b365d;
+  --xhl-active-ink: #eee8ff;
+  --xhl-ok: #22734f;
+  --xhl-ok-bg: #eaf8f0;
+  --xhl-off: #6a6788;
+  --xhl-off-bg: #eeedf6;
+}
+:root[data-xhl-theme="horizon"][data-xhl-scheme="dark"] {
+  --xhl-bg: #101022;
+  --xhl-panel: #1b1b32;
+  --xhl-soft: #23233e;
+  --xhl-ink: #eeecff;
+  --xhl-muted: #b0accd;
+  --xhl-border: #3c3a59;
+  --xhl-accent: #beaaff;
+  --xhl-tint: #342951;
+  --xhl-on-accent: #26194b;
+  --xhl-side: #15152b;
+  --xhl-side-ink: #cdcae7;
+  --xhl-side-muted: #a9a3c8;
+  --xhl-active: #393057;
+  --xhl-active-ink: #e2d7ff;
+  --xhl-ok: #89d6b0;
+  --xhl-ok-bg: #203f36;
+  --xhl-off: #b5aecf;
+  --xhl-off-bg: #36314c;
+}
+
+:root[data-xhl-theme] {
+  --xhl-radius: 8px;
+  --xhl-row-padding: .75em;
+  --xhl-success: #137346;
+  --xhl-warning: #865000;
+  --xhl-danger: #b4233b;
+  --xhl-info: #245fce;
+  --xhl-success-bg: #eaf8f0;
+  --xhl-warning-bg: #fff3d6;
+  --xhl-danger-bg: #ffedf0;
+  --xhl-info-bg: #eaf1ff;
+  background: var(--xhl-bg);
+  color: var(--xhl-ink);
+}
+:root[data-xhl-scheme="dark"] {
+  --xhl-success: #82d9ad;
+  --xhl-warning: #f0c36b;
+  --xhl-danger: #ff9fb1;
+  --xhl-info: #89b6ff;
+  --xhl-success-bg: #173e30;
+  --xhl-warning-bg: #45351c;
+  --xhl-danger-bg: #4b2430;
+  --xhl-info-bg: #233d60;
+}
+:root[data-xhl-theme="graphite"] { --xhl-radius: 3px; --xhl-row-padding: .4em; }
+:root[data-xhl-theme="alpine"] { --xhl-radius: 12px; --xhl-row-padding: .9em; }
+:root[data-xhl-theme] {
+  body, .page-header { background: var(--xhl-bg); color: var(--xhl-ink); }
+  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
+  a, .btn-link, .text-primary { color: var(--xhl-accent); }
+  .text-muted, .text-secondary { color: var(--xhl-muted) !important; }
+  .bg-faded, .bg-white { background: var(--xhl-soft) !important; }
+  hr, .table th, .table td, .table, .nav-tabs { border-color: var(--xhl-border); }
+  .card, .modal-content, .popover, .dropdown-menu, .list-group-item {
+    background: var(--xhl-panel); color: var(--xhl-ink); border-color: var(--xhl-border); border-radius: var(--xhl-radius);
+  }
+  .card-header, .card-footer, .modal-header, .modal-footer, .popover-title, .table-striped tbody tr:nth-of-type(odd) {
+    background: var(--xhl-soft); color: var(--xhl-ink); border-color: var(--xhl-border);
+  }
+  .dropdown-item, .popover-content { color: var(--xhl-ink); }
+  .dropdown-item:hover, .dropdown-item:focus, .table-hover tbody tr:hover { background: var(--xhl-tint); color: var(--xhl-ink); }
+  .dropdown-divider { border-color: var(--xhl-border); }
+  .form-control, .input-group-addon, .custom-select, .Select-control, .Select-menu-outer, .Select-option {
+    background: var(--xhl-panel); color: var(--xhl-ink); border-color: var(--xhl-border); border-radius: var(--xhl-radius);
+  }
+  .form-control::placeholder, .Select-placeholder { color: var(--xhl-muted); opacity: 1; }
+  .form-control:disabled, .form-control[readonly], .Select.is-disabled > .Select-control { background: var(--xhl-soft); color: var(--xhl-muted); }
+  .Select-input > input, .Select-value-label, .Select--single > .Select-control .Select-value { color: var(--xhl-ink) !important; }
+  .Select-option.is-focused, .Select-option.is-selected { background: var(--xhl-tint); color: var(--xhl-ink); }
+  .Select--multi .Select-value { background: var(--xhl-tint); color: var(--xhl-ink); border-color: var(--xhl-border); }
+  input[type="checkbox"], input[type="radio"] { accent-color: var(--xhl-accent); }
+  .btn { border-radius: var(--xhl-radius); }
+  .btn-secondary, .btn-default { background: var(--xhl-panel); color: var(--xhl-ink); border-color: var(--xhl-border); }
+  .btn-primary, .tag-primary, .page-item.active .page-link { background: var(--xhl-accent); color: var(--xhl-on-accent); border-color: var(--xhl-accent); }
+  .btn-primary:hover, .btn-primary:focus { background: var(--xhl-accent); color: var(--xhl-on-accent); filter: brightness(.92); }
+  .page-link { background: var(--xhl-panel); color: var(--xhl-accent); border-color: var(--xhl-border); }
+  .nav-tabs .nav-link { color: var(--xhl-muted); }
+  .nav-tabs .nav-link.active { background: var(--xhl-panel); color: var(--xhl-ink); border-color: var(--xhl-border); }
+  .nav-pills .nav-link.active { background: var(--xhl-tint); color: var(--xhl-accent); }
+  .xo-menu, .xo-sub-menu { background: var(--xhl-side); color: var(--xhl-side-ink); }
+  .xo-menu { padding: .6rem; border-right: 1px solid var(--xhl-border); }
+  .xo-menu .nav-link { border-radius: var(--xhl-radius); margin-bottom: 2px; }
+  .xo-menu-item:hover { background: var(--xhl-active); color: var(--xhl-active-ink); border-radius: var(--xhl-radius); }
+  .xo-menu .nav-link.active { background: var(--xhl-active); color: var(--xhl-active-ink); box-shadow: inset 3px 0 var(--xhl-accent); }
+  .xo-menu button { color: inherit; }
+  .xhl-home-list { background: var(--xhl-panel); border-radius: var(--xhl-radius); }
+  .xhl-appearance-fields { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-bottom: 1rem; }
+  .xhl-appearance-fields label { flex: 1 1 12em; max-width: 24em; }
+  .xhl-appearance-fields select { margin-top: .5rem; }
+  pre, code { background: var(--xhl-soft); color: var(--xhl-ink); border-color: var(--xhl-border); }
+  :focus-visible { outline: 2px solid var(--xhl-accent); outline-offset: 2px; }
+  .ct-label { fill: var(--xhl-muted); color: var(--xhl-muted); }
+  .ct-grid { stroke: var(--xhl-border); }
+  .ct-series-a .ct-line, .ct-series-a .ct-point { stroke: var(--xhl-accent); }
+  .ct-series-a .ct-area { fill: var(--xhl-accent); }
+  .ct-chart .chartist-tooltip { background: var(--xhl-panel); color: var(--xhl-ink); }
+  @each $state in success, warning, danger, info {
+    .text-#{$state} { color: var(--xhl-#{$state}) !important; }
+    .alert-#{$state}, .tag-#{$state}, .bg-#{$state}, .btn-#{$state} {
+      background: var(--xhl-#{$state}-bg) !important; color: var(--xhl-#{$state}) !important; border-color: var(--xhl-#{$state}) !important;
+    }
+    .notify-item.#{$state} { background: var(--xhl-#{$state}-bg); color: var(--xhl-#{$state}); border-color: var(--xhl-#{$state}); }
+  }
+  .notify-item.error { background: var(--xhl-danger-bg); color: var(--xhl-danger); border-color: var(--xhl-danger); }
+}
+:root[data-xhl-theme="alpine"] .xhl-home-list {
+  background: transparent; border: 0;
+  > div { background: var(--xhl-panel); border: 1px solid var(--xhl-border); border-radius: var(--xhl-radius); margin-bottom: .6rem; }
+}
+:root[data-xhl-theme="alpine"] .xo-menu .nav-link { border-radius: 1.5rem; }
+:root[data-xhl-theme="horizon"] .page-header { border-top: 3px solid var(--xhl-accent); }
+@media (prefers-reduced-motion: reduce) {
+  :root[data-xhl-theme] .xo-sub-menu { transition: none; }
+}
