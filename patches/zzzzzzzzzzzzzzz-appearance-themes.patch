diff --git a/packages/xo-web/src/common/xoa-hl-appearance/index.js b/packages/xo-web/src/common/xoa-hl-appearance/index.js
new file mode 100644
index 0000000..1e3379b
--- /dev/null
+++ b/packages/xo-web/src/common/xoa-hl-appearance/index.js
@@ -0,0 +1,55 @@
+// Keep normalization identical to the small pre-paint bootstrap in index.pug.
+export const THEMES = ['arctic', 'graphite', 'alpine', 'horizon']
+export const MODES = ['system', 'light', 'dark']
+export const STORAGE_NAME = 'xoa-hl.appearance.v1'
+export const normalize = (value = {}) => ({
+  theme: THEMES.includes(value && value.theme) ? value.theme : 'arctic',
+  mode: MODES.includes(value && value.mode) ? value.mode : 'system',
+})
+
+// Storage is optional (private browsing / browser policy may disable it).
+export function applyAppearance(value, win = window) {
+  const settings = normalize(value)
+  const root = win.document.documentElement
+  const dark = settings.mode === 'dark' ||
+    (settings.mode === 'system' && win.matchMedia('(prefers-color-scheme: dark)').matches)
+  root.setAttribute('data-xhl-theme', settings.theme)
+  root.setAttribute('data-xhl-mode', settings.mode)
+  root.setAttribute('data-xhl-scheme', dark ? 'dark' : 'light')
+  root.style.colorScheme = dark ? 'dark' : 'light'
+  try { win.localStorage.setItem(STORAGE_NAME, JSON.stringify(settings)) } catch (_) {}
+  return settings
+}
+
+export function startAppearance(store, win = window) {
+  let settings
+  try { settings = JSON.parse(win.localStorage.getItem(STORAGE_NAME)) } catch (_) {}
+  settings = applyAppearance(settings, win)
+  let previousUser
+  let previousPreferences
+  const sync = () => {
+    const user = store.getState().user
+    if (user) {
+      const preferences = user.preferences && user.preferences.xoaHlAppearance
+      if (user.id !== previousUser || preferences !== previousPreferences) {
+        previousUser = user.id
+        previousPreferences = preferences
+        settings = applyAppearance(preferences, win)
+      }
+    } else if (previousUser !== undefined) {
+      previousUser = previousPreferences = undefined
+      settings = applyAppearance(undefined, win)
+    }
+  }
+  sync()
+  const unsubscribe = store.subscribe(sync)
+  const media = win.matchMedia('(prefers-color-scheme: dark)')
+  const changed = () => { if (settings.mode === 'system') applyAppearance(settings, win) }
+  if (media.addEventListener) media.addEventListener('change', changed)
+  else media.addListener(changed)
+  return () => {
+    unsubscribe()
+    if (media.removeEventListener) media.removeEventListener('change', changed)
+    else media.removeListener(changed)
+  }
+}
diff --git a/packages/xo-web/src/common/xoa-hl-appearance/profile.js b/packages/xo-web/src/common/xoa-hl-appearance/profile.js
new file mode 100644
index 0000000..097f2bb
--- /dev/null
+++ b/packages/xo-web/src/common/xoa-hl-appearance/profile.js
@@ -0,0 +1,54 @@
+import React from 'react'
+import Component from 'base-component'
+import _ from 'intl'
+import { Card, CardBlock, CardHeader } from 'card'
+import { error } from 'notification'
+import { setXoaHlAppearance } from 'xo'
+import { normalize } from './index'
+
+export default class AppearancePreferences extends Component {
+  state = { saving: false }
+
+  _change = async event => {
+    const settings = normalize(this.props.user.preferences && this.props.user.preferences.xoaHlAppearance)
+    settings[event.target.name] = event.target.value
+    this.setState({ saving: true })
+    try {
+      // The store subscription applies only acknowledged server preferences.
+      await setXoaHlAppearance(settings)
+    } catch (err) {
+      error(_('xhlAppearanceSaveError'), err.message)
+    } finally {
+      this.setState({ saving: false })
+    }
+  }
+
+  render() {
+    const settings = normalize(this.props.user.preferences && this.props.user.preferences.xoaHlAppearance)
+    return (
+      <Card>
+        <CardHeader>{_('xhlAppearance')}</CardHeader>
+        <CardBlock>
+          <div className='xhl-appearance-fields' aria-busy={this.state.saving}>
+            <label htmlFor='xhl-theme'>{_('xhlTheme')}
+              <select id='xhl-theme' name='theme' className='form-control' value={settings.theme} disabled={this.state.saving} onChange={this._change}>
+                <option value='arctic'>Arctic</option>
+                <option value='graphite'>Graphite</option>
+                <option value='alpine'>Alpine</option>
+                <option value='horizon'>Horizon</option>
+              </select>
+            </label>
+            <label htmlFor='xhl-mode'>{_('xhlColorMode')}
+              <select id='xhl-mode' name='mode' className='form-control' value={settings.mode} disabled={this.state.saving} onChange={this._change}>
+                <option value='system'>{_('xhlSystem')}</option>
+                <option value='light'>{_('xhlLight')}</option>
+                <option value='dark'>{_('xhlDark')}</option>
+              </select>
+            </label>
+          </div>
+          <p className='text-muted'>{_('xhlAppearanceHelp')}</p>
+        </CardBlock>
+      </Card>
+    )
+  }
+}
