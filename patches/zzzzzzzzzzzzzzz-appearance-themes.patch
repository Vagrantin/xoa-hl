+  --xhl-ok-bg: #edf5f0;
+  --xhl-off: #696974;
+  --xhl-off-bg: #eeeeF2;
+}
+:root[data-xhl-theme="graphite"][data-xhl-scheme="dark"] {
+  --xhl-bg: #111114;
+  --xhl-panel: #1b1b20;
+  --xhl-soft: #222228;
+  --xhl-ink: #eeeeF4;
+  --xhl-muted: #ababbb;
+  --xhl-border: #393941;
+  --xhl-accent: #b7a5fa;
+  --xhl-tint: #302841;
+  --xhl-on-accent: #221734;
+  --xhl-side: #18181d;
+  --xhl-side-ink: #bdbdcb;
+  --xhl-side-muted: #aaaaba;
+  --xhl-active: #302d3b;
+  --xhl-active-ink: #d2c4ff;
+  --xhl-ok: #8dd2ad;
+  --xhl-ok-bg: #20382c;
+  --xhl-off: #b0b0be;
+  --xhl-off-bg: #30303b;
+}
+:root[data-xhl-theme="alpine"][data-xhl-scheme="light"] {
+  --xhl-bg: #f4f3ed;
+  --xhl-panel: #fffefa;
+  --xhl-soft: #f6f6f0;
+  --xhl-ink: #27392f;
+  --xhl-muted: #5c6c60;
+  --xhl-border: #dce1d5;
+  --xhl-accent: #276c50;
+  --xhl-tint: #edf4e9;
+  --xhl-on-accent: #ffffff;
+  --xhl-side: #e9eee3;
