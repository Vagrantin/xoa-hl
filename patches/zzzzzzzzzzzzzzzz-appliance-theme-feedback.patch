diff --git a/packages/xo-web/src/xoa-hl-themes.scss b/packages/xo-web/src/xoa-hl-themes.scss
index 0c23cb1..3585efd 100644
--- a/packages/xo-web/src/xoa-hl-themes.scss
+++ b/packages/xo-web/src/xoa-hl-themes.scss
@@ -188,6 +188,19 @@
 :root[data-xhl-theme="alpine"] { --xhl-radius: 12px; --xhl-row-padding: .9em; }
 :root[data-xhl-theme] {
   body, .page-header { background: var(--xhl-bg); color: var(--xhl-ink); }
+  // Keep React Select's search input transparent (a themed native input creates a visible box).
+  .Select-input > input { background: transparent; border: 0; box-shadow: none; outline: 0; }
+  .Select-menu, .Select-noresults, .Select-option-group-label { background: var(--xhl-panel); color: var(--xhl-ink); }
+  select.form-control option, select.form-control optgroup { background: var(--xhl-panel); color: var(--xhl-ink); }
+  .input-group > .input-group-btn { width: 1%; white-space: nowrap; }
+  .input-group > .input-group-btn > .btn-group { display: inline-block; }
+  .input-group > .input-group-btn .dropdown-toggle { position: relative; float: none; }
+  .xhl-server-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem; margin-bottom: 2rem; }
+  .xhl-server-form .form-group { margin: 0; }
+  .xhl-server-form .form-control { width: 100%; }
+  .xhl-server-form label { display: block; }
+  .xhl-brand { display: block; white-space: normal; line-height: 1.3; }
+  .xhl-brand small { display: block; font-size: .6em; color: var(--xhl-side-muted); }
   body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
   a, .btn-link, .text-primary { color: var(--xhl-accent); }
   .text-muted, .text-secondary { color: var(--xhl-muted) !important; }
