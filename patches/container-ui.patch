+import _ from 'intl'
+import ActionButton from 'action-button'
+import Component from 'base-component'
+import React from 'react'
+import { Modal } from 'react-bootstrap'
+import { getContainerLogs } from 'xo'
+
+// ===================================================================
+
+const MODAL_STYLE = {
+  maxHeight: '80vh',
+  overflowY: 'auto',
+}
+
+const LOG_STYLE = {
+  backgroundColor: '#f5f5f5',
+  padding: '10px',
+  borderRadius: '4px',
+  fontFamily: 'monospace',
+  fontSize: '12px',
+  whiteSpace: 'pre-wrap',
+  wordWrap: 'break-word',
+  maxHeight: '60vh',
+  overflowY: 'auto',
+}
+
+export default class ContainerLogsModal extends Component {
+  state = {
+    logs: '',
+    loading: true,
+    tail: 100,
+    follow: false,
+    timestamps: false,
+  }
+
+  componentDidMount() {
+    this._loadLogs()
+  }
+
+  _loadLogs = async () => {
+    const { container } = this.props
+    const { tail, follow, timestamps } = this.state
+
+    try {
+      this.setState({ loading: true })
+      const { logs } = await getContainerLogs(container.ID || container.Id, { tail, follow, timestamps })
+      this.setState({ logs, loading: false })
+    } catch (error) {
+      this.setState({ logs: `Error: ${error.message}`, loading: false })
+    }
+  }
+
+  _handleRefresh = () => {
+    this._loadLogs()
+  }
+
+  _handleTailChange = e => {
+    this.setState({ tail: parseInt(e.target.value) || 100 }, this._loadLogs)
+  }
+
+  _handleTimestampsToggle = () => {
+    this.setState(
+      state => ({ timestamps: !state.timestamps }),
+      this._loadLogs
+    )
+  }
+
+  render() {
+    const { container, onClose } = this.props
+    const { logs, loading, tail, timestamps } = this.state
+
+    return (
+      <Modal show onHide={onClose} style={MODAL_STYLE}>
+        <Modal.Header closeButton>
+          <Modal.Title>
+            {_('containersLogs')} - {container.Name || container.Names}
+          </Modal.Title>
+        </Modal.Header>
+        <Modal.Body>
+          <div style={{ marginBottom: '10px', display: 'flex', gap: '10px', alignItems: 'center' }}>
+            <div>
+              <label>{_('tailLines')}: </label>
+              <input
+                type='number'
+                value={tail}
+                onChange={this._handleTailChange}
+                min='1'
+                max='10000'
+                style={{ width: '80px' }}
+              />
+            </div>
+            <div>
+              <label>
+                <input
+                  type='checkbox'
+                  checked={timestamps}
+                  onChange={this._handleTimestampsToggle}
+                />
+                {_('timestamps')}
+              </label>
+            </div>
+            <ActionButton
+              btnStyle='info'
+              handler={this._handleRefresh}
+              pending={loading}
+              size='small'
+            >
+              <i className='fa fa-refresh' /> {_('refresh')}
+            </ActionButton>
+          </div>
+          {loading ? (
+            <p>{_('loading')}</p>
+          ) : (
+            <div style={LOG_STYLE}>{logs || _('noLogsAvailable')}</div>
+          )}
+        </Modal.Body>
+        <Modal.Footer>
+          <ActionButton
+            btnStyle='primary'
+            handler={onClose}
+          >
+            {_('close')}
+          </ActionButton>
+        </Modal.Footer>
+      </Modal>
+    )
+  }
+}
+
export { ContainerLogsModal }
