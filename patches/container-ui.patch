+import _ from 'intl'
+import ActionButton from 'action-button'
+import Component from 'base-component'
+import React from 'react'
+import { Modal } from 'react-bootstrap'
+import { createContainer, listImages, pullImage } from 'xo'
+
+// ===================================================================
+
+const MODAL_STYLE = {
+  maxHeight: '80vh',
+  overflowY: 'auto',
+}
+
+const FORM_GROUP_STYLE = {
+  marginBottom: '15px',
+}
+
+const INPUT_STYLE = {
+  width: '100%',
+  padding: '8px',
+  borderRadius: '4px',
+  border: '1px solid #ccc',
+}
+
+const LABEL_STYLE = {
+  display: 'block',
+  marginBottom: '5px',
+  fontWeight: 'bold',
+}
+
+export default class ContainerCreateModal extends Component {
+  state = {
+    name: '',
+    image: '',
+    availableImages: [],
+    loadingImages: false,
+    pullingImage: false,
+    cpuLimit: 1,
+    memoryLimit: 512,
+    memoryReservation: 256,
+    ports: [],
+    volumes: [],
+    environment: {},
+    privileged: false,
+    restartPolicy: 'no',
+    networkMode: '',
+    error: null,
+    creating: false,
+  }
+
+  componentDidMount() {
+    this._loadImages()
+  }
+
+  _loadImages = async () => {
+    try {
+      this.setState({ loadingImages: true })
+      const images = await listImages()
+      this.setState({ availableImages: images, loadingImages: false })
+    } catch (error) {
+      this.setState({ loadingImages: false })
+    }
+  }
+
+  _handlePullImage = async () => {
+    const { image } = this.state
+    if (!image) {
+      this.setState({ error: 'Please enter an image name' })
+      return
+    }
+
+    try {
+      this.setState({ pullingImage: true, error: null })
+      await pullImage(image)
+      await this._loadImages()
+      this.setState({ pullingImage: false })
+    } catch (error) {
+      this.setState({ pullingImage: false, error: error.message })
+    }
+  }
+
+  _handleCreate = async () => {
+    const {
+      name,
+      image,
+      cpuLimit,
+      memoryLimit,
+      memoryReservation,
+      ports,
+      volumes,
+      environment,
+      privileged,
+      restartPolicy,
+      networkMode,
+    } = this.state
+
+    if (!name || !image) {
+      this.setState({ error: 'Name and Image are required' })
+      return
+    }
+
+    try {
+      this.setState({ creating: true, error: null })
+      
+      await createContainer({
+        name,
+        image,
+        cpuLimit: parseFloat(cpuLimit),
+        memoryLimit: parseInt(memoryLimit) * 1024 * 1024,
+        memoryReservation: parseInt(memoryReservation) * 1024 * 1024,
+        ports,
+        volumes,
+        environment,
+        privileged,
+        restartPolicy,
+        networkMode,
+      })
+
+      this.setState({ creating: false })
+      this.props.onClose && this.props.onClose()
+      this.props.onCreated && this.props.onCreated()
+    } catch (error) {
+      this.setState({ creating: false, error: error.message })
+    }
+  }
+
+  _handleAddPort = () => {
+    this.setState({
+      ports: [...this.state.ports, { hostPort: '', containerPort: '' }],
+    })
+  }
+
+  _handleRemovePort = index => {
+    const ports = [...this.state.ports]
+    ports.splice(index, 1)
+    this.setState({ ports })
+  }
+
+  _handlePortChange = (index, field, value) => {
+    const ports = [...this.state.ports]
+    ports[index][field] = value
+    this.setState({ ports })
+  }
+
+  _handleAddVolume = () => {
+    this.setState({
+      volumes: [...this.state.volumes, { hostPath: '', containerPath: '' }],
+    })
+  }
+
+  _handleRemoveVolume = index => {
+    const volumes = [...this.state.volumes]
+    volumes.splice(index, 1)
+    this.setState({ volumes })
+  }
+
+  _handleVolumeChange = (index, field, value) => {
+    const volumes = [...this.state.volumes]
+    volumes[index][field] = value
+    this.setState({ volumes })
+  }
+
+  _handleAddEnv = () => {
+    this.setState({
+      environment: { ...this.state.environment, ['': ''] },
+    })
+  }
+
+  _handleRemoveEnv = key => {
+    const environment = { ...this.state.environment }
+    delete environment[key]
+    this.setState({ environment })
+  }
+
+  _handleEnvChange = (oldKey, key, value) => {
+    const environment = { ...this.state.environment }
+    if (oldKey && oldKey !== key) {
+      delete environment[oldKey]
+    }
+    environment[key] = value
+    this.setState({ environment })
+  }
+
+  render() {
+    const {
+      name,
+      image,
+      availableImages,
+      loadingImages,
+      pullingImage,
+      cpuLimit,
+      memoryLimit,
+      memoryReservation,
+      ports,
+      volumes,
+      environment,
+      privileged,
+      restartPolicy,
+      networkMode,
+      error,
+      creating,
+    } = this.state
+
+    return (
+      <Modal show onHide={this.props.onClose} style={MODAL_STYLE}>
+        <Modal.Header closeButton>
+          <Modal.Title>{_('containersCreateTitle')}</Modal.Title>
+        </Modal.Header>
+        <Modal.Body>
+          {error && <div style={{ color: 'red', marginBottom: '10px' }}>{error}</div>}
+
+          <div style={FORM_GROUP_STYLE}>
+            <label style={LABEL_STYLE}>{_('containersName')}</label>
+            <input
+              style={INPUT_STYLE}
+              type='text'
+              value={name}
+              onChange={e => this.setState({ name: e.target.value })}
+              placeholder='my-container'
+            />
+          </div>
+
+          <div style={FORM_GROUP_STYLE}>
+            <label style={LABEL_STYLE}>{_('containersImage')}</label>
+            <div style={{ display: 'flex', gap: '10px' }}>
+              <select
+                style={{ ...INPUT_STYLE, flex: 1 }}
+                value={image}
+                onChange={e => this.setState({ image: e.target.value })}
+                disabled={loadingImages}
+              >
+                <option value=''>{_('selectImage')}</option>
+                {availableImages.map(img => (
+                  <option key={img.ID || img.Id} value={img.Repository + ':' + img.Tag}>
+                    {img.Repository}:{img.Tag}
+                  </option>
+                ))}
+              </select>
+              <ActionButton
+                btnStyle='info'
+                handler={this._handlePullImage}
+                pending={pullingImage}
+                size='small'
+              >
+                {_('containersPullImage')}
+              </ActionButton>
+            </div>
+            <input
+              style={{ ...INPUT_STYLE, marginTop: '5px' }}
+              type='text'
+              value={image}
+              onChange={e => this.setState({ image: e.target.value })}
+              placeholder='nginx:latest'
+            />
+          </div>
+
+          <div style={FORM_GROUP_STYLE}>
+            <label style={LABEL_STYLE}>{_('containersCpuLimit')} ({_('optional')})</label>
+            <input
+              style={INPUT_STYLE}
+              type='number'
+              value={cpuLimit}
+              onChange={e => this.setState({ cpuLimit: parseFloat(e.target.value) || 1 })}
+              min='0.1'
+              step='0.1'
+            />
+          </div>
+
+          <div style={FORM_GROUP_STYLE}>
+            <label style={LABEL_STYLE}>{_('containersMemoryLimit')} (MB) ({_('optional')})</label>
+            <input
+              style={INPUT_STYLE}
+              type='number'
+              value={memoryLimit}
+              onChange={e => this.setState({ memoryLimit: parseInt(e.target.value) || 512 })}
+              min='0'
+            />
+          </div>
+
+          <div style={FORM_GROUP_STYLE}>
+            <label style={LABEL_STYLE}>{_('containersMemoryReservation')} (MB) ({_('optional')})</label>
+            <input
+              style={INPUT_STYLE}
+              type='number'
+              value={memoryReservation}
+              onChange={e => this.setState({ memoryReservation: parseInt(e.target.value) || 256 })}
+              min='0'
+            />
+          </div>
+
+          <div style={FORM_GROUP_STYLE}>
+            <label style={LABEL_STYLE}>{_('containersPorts')}</label>
+            {ports.map((port, index) => (
+              <div key={index} style={{ display: 'flex', gap: '5px', marginBottom: '5px' }}>
+                <input
+                  style={{ ...INPUT_STYLE, flex: 1 }}
+                  type='text'
+                  value={port.hostPort}
+                  onChange={e => this._handlePortChange(index, 'hostPort', e.target.value)}
+                  placeholder='Host Port'
+                />
+                <input
+                  style={{ ...INPUT_STYLE, flex: 1 }}
+                  type='text'
+                  value={port.containerPort}
+                  onChange={e => this._handlePortChange(index, 'containerPort', e.target.value)}
+                  placeholder='Container Port'
+                />
+                <button
+                  type='button'
+                  className='btn btn-danger btn-sm'
+                  onClick={() => this._handleRemovePort(index)}
+                >
+                  <i className='fa fa-trash' />
+                </button>
+              </div>
+            ))}
+            <button type='button' className='btn btn-secondary btn-sm' onClick={this._handleAddPort}>
+              <i className='fa fa-plus' /> {_('add')}
+            </button>
+          </div>
+
