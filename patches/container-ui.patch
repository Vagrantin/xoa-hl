+import _ from 'intl'
+import ActionButton from 'action-button'
+import Component from 'base-component'
+import React from 'react'
+import { connect } from 'react-redux'
+import { createSelector } from 'reselect'
+import { ContainerCreateModal } from '../create-modal'
+import { ContainerLogsModal } from '../logs-modal'
+import { listContainers, startContainer, stopContainer, restartContainer, removeContainer, getContainerLogs } from 'xo'
+import { addSubscriptions, deleteSubscriptions, subscribeToResource } from 'xo-react-helpers'
+
+// ===================================================================
+
+const CONTAINER_STYLE = {
+  marginBottom: '10px',
+}
+
+const STATUS_STYLE = {
+  display: 'inline-block',
+  padding: '3px 8px',
+  borderRadius: '4px',
+  fontSize: '12px',
+  fontWeight: 'bold',
+}
+
+const STATUS_COLORS = {
+  running: '#28a745',
+  stopped: '#dc3545',
+  paused: '#ffc107',
+  created: '#17a2b8',
+  restarting: '#007bff',
+  removing: '#6c757d',
+}
+
+const getContainerStatusColor = status => {
+  const lowerStatus = (status || '').toLowerCase()
+  return STATUS_COLORS[lowerStatus] || '#6c757d'
+}
+
+@connect(
+  createSelector(
+    [state => state],
+    state => ({
+      containers: state.containers || [],
+    })
+  )
+)
+class ContainerList extends Component {
+  state = {
+    containers: [],
+    loading: true,
+    error: null,
+    showCreateModal: false,
+    showLogsModal: false,
+    selectedContainer: null,
+  }
+
+  componentDidMount() {
+    this._loadContainers()
+    this._setupSubscriptions()
+  }
+
+  componentWillUnmount() {
+    this._cleanupSubscriptions()
+  }
+
+  _setupSubscriptions = () => {
+    this._subscriptions = [
+      subscribeToResource('container', '>', this._loadContainers),
+    ]
+  }
+
+  _cleanupSubscriptions = () => {
+    if (this._subscriptions) {
+      this._subscriptions.forEach(sub => sub.unsubscribe())
+      this._subscriptions = null
+    }
+  }
+
+  _loadContainers = async () => {
+    try {
+      this.setState({ loading: true, error: null })
+      const containers = await listContainers()
+      this.setState({ containers, loading: false })
+    } catch (error) {
+      this.setState({ error: error.message, loading: false })
+    }
+  }
+
+  _handleStart = async container => {
+    try {
+      await startContainer(container.ID || container.Id)
+      this._loadContainers()
+    } catch (error) {
+      alert(`Failed to start container: ${error.message}`)
+    }
+  }
+
+  _handleStop = async (container, force = false) => {
+    try {
+      await stopContainer(container.ID || container.Id, force)
+      this._loadContainers()
+    } catch (error) {
+      alert(`Failed to stop container: ${error.message}`)
+    }
+  }
+
+  _handleRestart = async (container, force = false) => {
+    try {
+      await restartContainer(container.ID || container.Id, force)
+      this._loadContainers()
+    } catch (error) {
+      alert(`Failed to restart container: ${error.message}`)
+    }
+  }
+
+  _handleRemove = async (container, force = false) => {
+    if (!window.confirm(`Are you sure you want to remove container "${container.Name || container.Names}"?`)) {
+      return
+    }
+    try {
+      await removeContainer(container.ID || container.Id, force, true)
+      this._loadContainers()
+    } catch (error) {
+      alert(`Failed to remove container: ${error.message}`)
+    }
+  }
+
+  _handleLogs = container => {
+    this.setState({
+      showLogsModal: true,
+      selectedContainer: container,
+    })
+  }
+
+  _handleCreate = () => {
+    this.setState({ showCreateModal: true })
+  }
+
+  _handleCreateClose = () => {
+    this.setState({ showCreateModal: false })
+    this._loadContainers()
+  }
+
+  _handleLogsClose = () => {
+    this.setState({ showLogsModal: false, selectedContainer: null })
+  }
+
+  render() {
+    const { containers, loading, error, showCreateModal, showLogsModal, selectedContainer } = this.state
+
+    return (
+      <div>
+        <div style={{ marginBottom: '20px' }}>
+          <ActionButton btnStyle='success' handler={this._handleCreate} icon='fa-plus'>
+            {_('containersCreate')}
+          </ActionButton>
+        </div>
+
+        {loading && <p>{_('loading')}</p>}
+        {error && <p style={{ color: 'red' }}>{error}</p>}
+
+        {!loading && !error && (
+          <div className='table-responsive'>
+            <table className='table table-striped table-hover'>
+              <thead>
+                <tr>
+                  <th>{_('containersName')}</th>
+                  <th>{_('containersImage')}</th>
+                  <th>{_('containersStatus')}</th>
+                  <th>{_('containersCpu')}</th>
+                  <th>{_('containersMemory')}</th>
+                  <th>{_('containersActions')}</th>
+                </tr>
+              </thead>
+              <tbody>
+                {containers.length === 0 ? (
+                  <tr>
+                    <td colSpan='6' style={{ textAlign: 'center' }}>
+                      {_('noItemsAvailable')}
+                    </td>
+                  </tr>
+                ) : (
+                  containers.map(container => (
+                    <tr key={container.ID || container.Id}>
+                      <td>{container.Name || container.Names}</td>
+                      <td>{container.Image}</td>
+                      <td>
+                        <span
+                          style={{
+                            ...STATUS_STYLE,
+                            backgroundColor: getContainerStatusColor(container.State || container.Status),
+                            color: 'white',
+                          }}
+                        >
+                          {container.State || container.Status}
+                        </span>
+                      </td>
+                      <td>{container.CPU || '0%'}</td>
+                      <td>
+                        {container.Memory || '0B'} / {container.MemoryLimit || 'unlimited'}
+                      </td>
+                      <td>
+                        <div style={{ display: 'flex', gap: '5px' }}>
+                          {(container.State === 'running' || container.Status === 'running') && (
+                            <ActionButton
+                              btnStyle='warning'
+                              handler={() => this._handleStop(container)}
+                              icon='fa-stop'
+                              size='small'
+                              tooltip={_('containersStop')}
+                            />
+                          )}
+                          {(container.State === 'stopped' || container.Status === 'stopped' || container.State === 'created' || container.Status === 'created') && (
+                            <ActionButton
+                              btnStyle='success'
+                              handler={() => this._handleStart(container)}
+                              icon='fa-play'
+                              size='small'
+                              tooltip={_('containersStart')}
+                            />
+                          )}
+                          <ActionButton
+                            btnStyle='info'
+                            handler={() => this._handleRestart(container)}
+                            icon='fa-refresh'
+                            size='small'
+                            tooltip={_('containersRestart')}
+                          />
+                          <ActionButton
+                            btnStyle='primary'
+                            handler={() => this._handleLogs(container)}
+                            icon='fa-file-text'
+                            size='small'
+                            tooltip={_('containersLogs')}
+                          />
+                          <ActionButton
+                            btnStyle='danger'
+                            handler={() => this._handleRemove(container)}
+                            icon='fa-trash'
+                            size='small'
+                            tooltip={_('containersRemove')}
+                          />
+                        </div>
+                      </td>
+                    </tr>
+                  ))
+                )}
+              </tbody>
+            </table>
+          </div>
+        )}
+
+        {showCreateModal && (
+          <ContainerCreateModal onClose={this._handleCreateClose} onCreated={this._loadContainers} />
+        )}
+
+        {showLogsModal && selectedContainer && (
+          <ContainerLogsModal
+            container={selectedContainer}
+            onClose={this._handleLogsClose}
+          />
+        )}
+      </div>
+    )
+  }
+}
+
export { ContainerList }
