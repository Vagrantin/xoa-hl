diff --git a/packages/xo-server/src/api/xoaHl.mjs b/packages/xo-server/src/api/xoaHl.mjs
new file mode 100644
index 0000000..0918094
--- /dev/null
+++ b/packages/xo-server/src/api/xoaHl.mjs
@@ -0,0 +1,177 @@
+import { execa } from 'execa'
+import { readFile, stat } from 'fs/promises'
+
+// Written by /usr/libexec/xoa-hl/check-update.sh. On /run on purpose: a check
+// result describes the repositories as they were, and must not outlive a boot.
+const STATUS_FILE = '/run/xoa-hl/status'
+
+// Written by /usr/libexec/xoa-hl/update.sh, line by line as dnf produces them.
+// On /var/lib rather than /run because an update can end with a pending reboot,
+// and a tmpfs log would be gone exactly when someone wants to read it.
+const LOG_FILE = '/var/lib/xoa-hl/update.log'
+
+const CHECK_UNIT = 'xoa-hl-check-update.service'
+const UPDATE_UNIT = 'xoa-hl-update.service'
+
+// -------------------------------------------------------------------
+
+export async function getVersion() {
+  try {
+    const { stdout } = await execa('rpm', ['-q', '--qf', '%{VERSION}-%{RELEASE}\\n', 'xoa-hl'])
+    return stdout.trim()
+  } catch (error) {
+    // not running on the appliance, or package not found
+    return { error: 'unknown' }
+  }
+}
+getVersion.permission = 'admin'
+getVersion.description = 'get the installed version of xoa-hl'
+
+// -------------------------------------------------------------------
+
+// check-update.sh writes a verdict on the first line, then any number of
+// "key=value" metadata lines and "name<TAB>version" package lines:
+//
+//   AVAILABLE | UP_TO_DATE | ERROR
+//   checkedAt=2026-09-16T08:00:00Z
+//   message=Curl error (6): Couldn't resolve host name   (ERROR only)
+//   xoa-hl<TAB>5.113.2_e281c536-42                       (AVAILABLE only)
+function parseStatus(content) {
+  const [verdict, ...rest] = content.trim().split('\n')
+
+  const packages = []
+  let checkedAt, message
+  for (const line of rest) {
+    if (line.startsWith('checkedAt=')) {
+      checkedAt = line.slice(10)
+    } else if (line.startsWith('message=')) {
+      message = line.slice(8)
+    } else if (line !== '') {
+      const [name, version] = line.split('\t')
+      packages.push({ name, version })
+    }
+  }
+
+  if (verdict === 'ERROR') {
+    return { checkedAt, error: message ?? 'the update check failed', packages: [], updateAvailable: false }
+  }
+  if (verdict === 'AVAILABLE') {
+    return { checkedAt, packages, updateAvailable: packages.length > 0 }
+  }
+  // UP_TO_DATE. Anything unrecognised lands here too: reporting "nothing
+  // pending" is the only honest reading of a verdict we cannot interpret, and
+  // it is what the caller would do with an unknown value anyway.
+  return { checkedAt, packages: [], updateAvailable: false }
+}
+
+export async function getUpdateStatus() {
+  let content
+  try {
+    content = await readFile(STATUS_FILE, 'utf8')
+  } catch (error) {
+    // never checked on this boot
+    return { packages: [], updateAvailable: false }
+  }
+
+  return parseStatus(content)
+}
+getUpdateStatus.permission = 'admin'
+getUpdateStatus.description = 'get the latest xoa-hl update check result'
+
+// -------------------------------------------------------------------
+
+export async function checkForUpdate() {
+  // Blocking, unlike startUpdate: a check is a request/response as far as the
+  // UI is concerned, and it reports its own failures through the status file
+  // rather than by failing the unit, so this only rejects when the unit itself
+  // could not be started.
+  await execa('sudo', ['systemctl', 'start', CHECK_UNIT])
+
+  // Returning the result saves the caller a second round trip, and removes the
+  // window in which the page would have a stale verdict on screen.
+  return getUpdateStatus()
+}
+checkForUpdate.permission = 'admin'
+checkForUpdate.description = 'run a check for xoa-hl updates and return its result'
+
+// -------------------------------------------------------------------
+
+export async function startUpdate() {
+  // --no-block is what makes the live log possible: the unit is Type=oneshot,
+  // so without it systemd would not report the job done -- and this call would
+  // not return -- until the whole transaction had finished.
+  await execa('sudo', ['systemctl', 'start', '--no-block', UPDATE_UNIT])
+
+  // The caller compares this against the log's mtime to tell this run's log
+  // from the previous run's, which is still on disk until update.sh truncates
+  // it. Same clock on both sides, so the comparison is meaningful.
+  return { requestedAt: Date.now(), started: true }
+}
+startUpdate.permission = 'admin'
+startUpdate.description = 'start the xoa-hl update, returns as soon as it is queued'
+
+// -------------------------------------------------------------------
+
+// systemd reports a oneshot as activating while ExecStart runs; deactivating is
+// the tail of a run that is on its way out but has not reported a result yet.
+const RUNNING_STATES = new Set(['activating', 'active', 'deactivating', 'reloading'])
+
+async function readLog() {
+  let content, mtime
+  try {
+    mtime = (await stat(LOG_FILE)).mtimeMs
+    content = await readFile(LOG_FILE, 'utf8')
+  } catch (error) {
+    if (error.code === 'ENOENT') {
+      // no update has ever run on this appliance
+      return { lines: [] }
+    }
+    throw error
+  }
+
+  // The trailing newline would otherwise read as a blank last line that keeps
+  // moving down as the file grows.
+  if (content.endsWith('\n')) {
+    content = content.slice(0, -1)
+  }
+
+  return { lines: content === '' ? [] : content.split('\n'), mtime }
+}
+
+export async function getUpdateProgress({ since = 0 } = {}) {
+  const [{ stdout }, { lines, mtime }] = await Promise.all([
+    execa('systemctl', ['show', UPDATE_UNIT, '--property=ActiveState,SubState,ExecMainStatus']),
+    readLog(),
+  ])
+
+  const properties = {}
+  for (const line of stdout.split('\n')) {
+    const i = line.indexOf('=')
+    if (i !== -1) {
+      properties[line.slice(0, i)] = line.slice(i + 1)
+    }
+  }
+
+  // A run truncates the log, so a file shorter than what the caller has already
+  // read means it was looking at the previous run: tell it to replace rather
+  // than append, instead of silently handing it a spliced-together log.
+  const truncated = lines.length < since
+
+  const { ActiveState: activeState } = properties
+  return {
+    activeState,
+    exitStatus: Number(properties.ExecMainStatus),
+    failed: activeState === 'failed',
+    lines: lines.slice(truncated ? 0 : since),
+    logModifiedAt: mtime,
+    nextSince: lines.length,
+    running: RUNNING_STATES.has(activeState),
+    subState: properties.SubState,
+    truncated,
+  }
+}
+getUpdateProgress.permission = 'admin'
+getUpdateProgress.description = 'get the state of the xoa-hl update service and the log lines written since `since`'
+getUpdateProgress.params = {
+  since: { type: 'number', optional: true },
+}
