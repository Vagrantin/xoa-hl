@@ -0,0 +1,693 @@
+import _ from 'intl'
+import ActionButton from 'action-button'
+import Component from 'base-component'
+import Icon from 'icon'
+import React from 'react'
+import UserError from 'user-error'
+import { Card, CardBlock, CardHeader } from 'card'
+import { Col, Container, Row } from 'grid'
+import { FormattedRelative } from 'react-intl'
+import {
+  checkXoaHlUpdate,
+  getXoaHlUpdateConfiguration,
+  getXoaHlUpdateProgress,
+  getXoaHlVersion,
+  setXoaHlUpdateConfiguration,
+  startXoaHlUpdate,
+} from 'xo'
+
+// ===================================================================
+
+// How often the page asks for the log lines written since its last poll.
+const POLL_INTERVAL = 2e3
+
+// The first poll comes sooner, so the pane fills as soon as dnf says anything
+// rather than a whole interval later.
+const FIRST_POLL_INTERVAL = 5e2
+
+// How long a queued update may take to touch its log before the page calls it a
+// failure to start. Generous: this only covers systemd dispatching the job.
+const START_TIMEOUT = 3e4
+
+// How long xo-server may stay unreachable before the page stops calling it a
+// routine restart and offers a reload as well.
+const SLOW_RECONNECT_DELAY = 6e4
+
+// Where this tab remembers the update it started, so a reload in the middle of
+// it -- the one thing a user can do while xo-server is restarting -- comes back
+// to the same run and its outcome instead of an idle page. Per tab on purpose:
+// another tab adopts a running update on its own, and has no business being
+// shown the outcome of one it did not start.
+const ACTIVE_UPDATE_KEY = 'xoaHlActiveUpdate'
+
+// Storage can be disabled or full; losing the marker only loses the recovery.
+const loadActiveUpdate = () => {
+  try {
+    const value = JSON.parse(window.sessionStorage.getItem(ACTIVE_UPDATE_KEY))
+    if (value !== null && typeof value.requestedAt === 'number' && typeof value.startedAt === 'number') {
+      return value
+    }
+  } catch (error) {
+    // no marker, or one this page cannot read: nothing to recover
+  }
+}
+
+const saveActiveUpdate = value => {
+  try {
+    if (value === undefined) {
+      window.sessionStorage.removeItem(ACTIVE_UPDATE_KEY)
+    } else {
+      window.sessionStorage.setItem(ACTIVE_UPDATE_KEY, JSON.stringify(value))
+    }
+  } catch (error) {
+    // the update itself is unaffected, only a reload would not find it again
+  }
+}
+
+// xo-server serves this page too, so reloading it while xo-server is down
+// swaps a page that will reconnect on its own for a browser error page. Only
+// reload once the server answers.
+const reloadWhenReachable = async () => {
+  let response
+  try {
+    response = await window.fetch(window.location.href, { cache: 'no-store', method: 'HEAD' })
+  } catch (error) {
+    // a network error is the answer we are testing for, reported below
+  }
+
+  if (response === undefined || !response.ok) {
+    throw new UserError(_('xoaHlReloadPage'), _('xoaHlServerUnreachable'))
+  }
+
+  window.location.reload()
+}
+
+// Tall enough to be worth reading, capped so the buttons stay on screen.
+const LOG_STYLE = {
+  marginBottom: 0,
+  maxHeight: '30em',
+  minHeight: '10em',
+  overflowY: 'auto',
+  whiteSpace: 'pre-wrap',
+  wordBreak: 'break-word',
+}
+
+// ===================================================================
+
+const Banner = ({ children, icon, level }) => (
+  <div className={`alert alert-${level} mb-1`} role='alert'>
+    <Icon fixedWidth icon={icon} /> {children}
+  </div>
+)
+
+const CheckedAt = ({ value }) => {
+  const date = new Date(value)
+  if (isNaN(date.getTime())) {
+    return null
+  }
+
+  return (
+    <span className='text-muted ml-1'>
+      ({_('xoaHlLastChecked')} <FormattedRelative value={date} />)
+    </span>
+  )
+}
+
+const PackagesTable = ({ packages }) => (
+  <div>
+    <p className='mb-1'>{_('xoaHlPackagesAvailable')}</p>
+    <table className='table table-sm'>
+      <thead>
+        <tr>
+          <th>{_('xoaHlPackageName')}</th>
+          <th>{_('xoaHlPackageVersion')}</th>
+        </tr>
+      </thead>
+      <tbody>
+        {packages.map(({ name, version }) => (
+          <tr key={name}>
+            <td>{name}</td>
+            <td className='text-monospace'>{version}</td>
+          </tr>
+        ))}
+      </tbody>
+    </table>
+  </div>
+)
+
+// ===================================================================
+
+export default class XoaHlUpdates extends Component {
+  constructor(props) {
+    super(props)
+    this.state = {
+      automaticInstallConfirmed: false,
+      checking: false,
+      configuration: undefined,
+      configurationLoading: true,
+      configurationSaving: false,
+      log: [],
+      // undefined while an update is running, then 'succeeded', 'failed' or
+      // 'didNotStart'
+      outcome: undefined,
+      // set while polling is failing, which is expected rather than an error:
+      // the transaction restarts xo-server underneath this very page
+      reconnecting: false,
+      // browser clock readings: when polling started failing, and when it last
+      // failed. The second one changing is also what re-renders the elapsed time.
+      reconnectingSince: 0,
+      lastFailedPollAt: 0,
+      // server clock reading taken when this page queued the update. The log on
+      // disk belongs to the previous run until its mtime passes this.
+      requestedAt: 0,
+      // number of log lines already received; the server sends only what
+      // follows them
+      since: 0,
+      started: false,
+      // undefined until a check has run: the page says "unknown" rather than
+      // inventing "up to date"
+      status: undefined,
+      updating: false,
+      version: undefined,
+    }
+
+    // Browser clock, and compared only against other browser-clock readings --
+    // state.requestedAt is the appliance's clock and the two are not
+    // interchangeable.
+    this._updateStartedAt = Date.now()
+
+    // Whether the log pane is following its tail. Cleared as soon as the reader
+    // scrolls up to look at something.
+    this._followLog = true
+  }
+
+  componentDidMount() {
+    this._mounted = true
+
+    getXoaHlUpdateConfiguration().then(
+      configuration => this._mounted && this.setState({ configuration, configurationLoading: false }),
+      () => this._mounted && this.setState({ configurationLoading: false })
+    )
+
+    getXoaHlVersion().then(
+      version => this._mounted && this.setState({ version: typeof version === 'string' ? version : undefined }),
+      // an appliance that cannot report its version is no reason to fail the
+      // page, everything else on it still works
+      () => {}
+    )
+
+    // This tab started an update and was reloaded before seeing its outcome:
+    // follow the same run again.
+    const activeUpdate = loadActiveUpdate()
+    if (activeUpdate !== undefined) {
+      this._updateStartedAt = activeUpdate.startedAt
+      this.setState({ requestedAt: activeUpdate.requestedAt, status: undefined, updating: true })
+    }
+
+    // An update may already be running -- started from another browser tab, or
+    // from the shell -- so adopt it instead of showing an idle page.
+    this._tick()
+  }
+
+  componentWillUnmount() {
+    this._mounted = false
+    clearTimeout(this._timeout)
+  }
+
+  componentDidUpdate(prevProps, prevState) {
+    const node = this._logNode
+    if (node == null || this.state.log === prevState.log || !this._followLog) {
+      return
+    }
+
+    node.scrollTop = node.scrollHeight
+  }
+
+  _setLogNode = node => {
+    this._logNode = node
+  }
+
+  _onLogScroll = event => {
+    const { clientHeight, scrollHeight, scrollTop } = event.target
+    // A few pixels of slack: browsers report fractional scroll positions.
+    this._followLog = scrollHeight - scrollTop - clientHeight < 4
+  }
+
+  // -----------------------------------------------------------------
+
+
+  _setConfigurationField = field => event => {
+    const value = field === 'randomDelayMinutes' ? Number(event.target.value) : event.target.value
+    this.setState(({ automaticInstallConfirmed, configuration }) => ({
+      automaticInstallConfirmed: field === 'mode' && value !== 'install' ? false : automaticInstallConfirmed,
+      configuration: { ...configuration, [field]: value },
+    }))
+  }
+
+  _saveConfiguration = async () => {
+    const { configuration } = this.state
+    this.setState({ configurationSaving: true })
+    try {
+      const saved = await setXoaHlUpdateConfiguration({
+        day: configuration.day,
+        frequency: configuration.frequency,
+        mode: configuration.mode,
+        randomDelayMinutes: configuration.randomDelayMinutes,
+        time: configuration.time,
+      })
+      if (this._mounted) {
+        this.setState({ automaticInstallConfirmed: false, configuration: saved, configurationSaving: false })
+      }
+    } catch (error) {
+      if (this._mounted) {
+        this.setState({ configurationSaving: false })
+      }
+      throw error
+    }
+  }
+
+  _checkForUpdate = async () => {
+    // Clearing the verdict is the point: "Up to date" describes the previous
+    // check and must not sit on screen next to the spinner for the new one.
+    this.setState({ checking: true, status: undefined })
+    try {
+      const status = await checkXoaHlUpdate()
+      if (this._mounted) {
+        this.setState({ checking: false, status })
+      }
+    } catch (error) {
+      if (this._mounted) {
+        this.setState({ checking: false })
+      }
+      // ActionButton turns this into a notification
+      throw error
+    }
+  }
+
+  _startUpdate = async () => {
+    this._followLog = true
+    this._updateStartedAt = Date.now()
+    this.setState({
+      log: [],
+      outcome: undefined,
+      reconnecting: false,
+      since: 0,
+      started: false,
+      // The verdict describes the appliance as it was before the transaction;
+      // only a fresh check can say what it is afterwards.
+      status: undefined,
+      updating: true,
+    })
+
+    let requestedAt
+    try {
+      const result = await startXoaHlUpdate()
+      requestedAt = result.requestedAt
+    } catch (error) {
+      if (this._mounted) {
+        this.setState({ updating: false })
+      }
+      // ActionButton turns this into a notification
+      throw error
+    }
+
+    saveActiveUpdate({ requestedAt, startedAt: this._updateStartedAt })
+
+    if (this._mounted) {
+      this.setState({ requestedAt })
+      this._schedule(FIRST_POLL_INTERVAL)
+    }
+  }
+
+  // Every way a followed run ends goes through here, so the marker never
+  // outlives the run it describes.
+  _setOutcome(outcome) {
+    saveActiveUpdate(undefined)
+    this.setState({ outcome, reconnecting: false, updating: false })
+  }
+
+  // -----------------------------------------------------------------
+
+  _schedule(delay = POLL_INTERVAL) {
+    clearTimeout(this._timeout)
+    this._timeout = setTimeout(this._tick, delay)
+  }
+
+  _tick = async () => {
+    if (!this._mounted) {
+      return
+    }
+
+    let progress
+    try {
+      progress = await getXoaHlUpdateProgress(this.state.since)
+    } catch (error) {
+      // Expected in the middle of a successful update: installing xoa-hl
+      // restarts xo-server, so the connection this page polls over drops for a
+      // few seconds. Keep the log on screen and keep trying.
+      if (this._mounted && this.state.updating) {
+        const now = Date.now()
+        this.setState(({ reconnecting, reconnectingSince }) => ({
+          lastFailedPollAt: now,
+          reconnecting: true,
+          reconnectingSince: reconnecting ? reconnectingSince : now,
+        }))
+        this._schedule()
+      }
+      return
+    }
+
+    if (!this._mounted) {
+      return
+    }
+
+    const { failed, lines, logModifiedAt, nextSince, running, truncated } = progress
+    const { requestedAt, updating } = this.state
+
+    if (!updating && !running) {
+      // Nothing to follow. This is the usual case on mount, and it is why the
+      // previous run's log stays off screen: with no outcome beside it, it
+      // would read as this session's.
+      return
+    }
+
+    // Until the log on disk is newer than this page's request it is still the
+    // previous run's, and showing it would put a finished update's output under
+    // a "starting" spinner.
+    if (logModifiedAt === undefined || logModifiedAt < requestedAt) {
+      if (Date.now() - this._updateStartedAt > START_TIMEOUT) {
+        this._setOutcome('didNotStart')
+      } else {
+        this.setState({ reconnecting: false })
+        this._schedule()
+      }
+      return
+    }
+
+    this.setState(({ log }) => ({
+      log: truncated ? lines : log.concat(lines),
+      reconnecting: false,
+      since: nextSince,
+      started: true,
+    }))
+
+    if (running) {
+      if (!updating) {
+        // adopted a run this page did not start
+        this.setState({ outcome: undefined, updating: true })
+      }
+      this._schedule()
+      return
+    }
+
+    this._setOutcome(failed ? 'failed' : 'succeeded')
+  }
+
+  // -----------------------------------------------------------------
+
+  // One banner, always, so the page never shows two verdicts at once.
+  _renderStatus() {
+    const { checking, outcome, status, updating } = this.state
+
+    if (checking) {
+      return (
+        <Banner icon='loading' level='info'>
+          {_('xoaHlChecking')}
+        </Banner>
+      )
+    }
+
+    if (updating) {
+      // The log card carries the running banner; a second one here would only
+      // repeat it.
+      return null
+    }
+
+    if (status === undefined && outcome !== undefined) {
+      // After a run the outcome is the current verdict: the check that ran
+      // before it described an appliance that no longer exists.
+      return this._renderOutcome()
+    }
+
+    if (status === undefined) {
+      return (
+        <Banner icon='info' level='info'>
+          {_('xoaHlNeverChecked')}
+        </Banner>
+      )
+    }
+
+    const { checkedAt, error, packages, updateAvailable } = status
+
+    if (error !== undefined) {
+      return (
+        <Banner icon='alarm' level='danger'>
+          <strong>{_('xoaHlCheckFailed')}</strong>: {error}
+          <CheckedAt value={checkedAt} />
+        </Banner>
+      )
+    }
+
+    if (!updateAvailable) {
+      return (
+        <Banner icon='check' level='success'>
+          <strong>{_('xoaHlUpToDate')}</strong>
+          <CheckedAt value={checkedAt} />
+        </Banner>
+      )
+    }
+
+    return (
+      <div>
+        <Banner icon='alarm' level='warning'>
+          <strong>{_('xoaHlUpdateAvailable', { n: packages.length })}</strong>
+          <CheckedAt value={checkedAt} />
+        </Banner>
+        <PackagesTable packages={packages} />
+      </div>
+    )
+  }
+
+  _renderOutcome() {
+    switch (this.state.outcome) {
+      case 'succeeded':
+        return (
+          <Banner icon='success' level='success'>
+            <strong>{_('xoaHlUpdateSucceeded')}</strong> {_('xoaHlRecheckAfterUpdate')}
+          </Banner>
+        )
+      case 'failed':
+        return (
+          <Banner icon='error' level='danger'>
+            <strong>{_('xoaHlUpdateFailed')}</strong>
+          </Banner>
+        )
+      case 'didNotStart':
+        return (
+          <Banner icon='error' level='danger'>
+            <strong>{_('xoaHlUpdateDidNotStart')}</strong>
+          </Banner>
+        )
+      default:
+        return null
+    }
+  }
+
+  _renderReconnecting() {
+    const { lastFailedPollAt, reconnectingSince } = this.state
+    const elapsed = lastFailedPollAt - reconnectingSince
+
+    if (elapsed < SLOW_RECONNECT_DELAY) {
+      return <span className='ml-1'>{_('xoaHlUpdateReconnecting')}</span>
+    }
+
+    return (
+      <div className='mt-1'>
+        <p className='mb-1'>{_('xoaHlUpdateReconnectingSlow', { seconds: Math.round(elapsed / 1e3) })}</p>
+        <ActionButton btnStyle='primary' handler={reloadWhenReachable} icon='refresh' size='small'>
+          {_('xoaHlReloadPage')}
+        </ActionButton>
+      </div>
+    )
+  }
+
+  _renderLog() {
+    const { log, reconnecting, started, updating } = this.state
+
+    if (log.length === 0 && !updating) {
+      return null
+    }
+
+    return (
+      <Row className='mt-1'>
+        <Col>
+          <Card>
+            <CardHeader>
+              <Icon icon='logs' /> {_('xoaHlUpdateLog')}
+            </CardHeader>
+            <CardBlock>
+              {updating && (
+                <Banner icon='loading' level='info'>
+                  {started ? _('xoaHlUpdateRunning') : _('xoaHlUpdateStarting')}
+                  {reconnecting && this._renderReconnecting()}
+                </Banner>
+              )}
+              {log.length === 0 ? (
+                <p className='mb-0 text-muted'>{_('xoaHlWaitingForOutput')}</p>
+              ) : (
+                <pre className='mb-0' onScroll={this._onLogScroll} ref={this._setLogNode} style={LOG_STYLE}>
+                  {log.join('\n')}
+                </pre>
+              )}
+            </CardBlock>
+          </Card>
+        </Col>
+      </Row>
+    )
+  }
+
+
+  _renderAutomaticUpdates() {
+    const {
+      automaticInstallConfirmed,
+      configuration,
+      configurationLoading,
+      configurationSaving,
+    } = this.state
+
+    if (configurationLoading) {
+      return <p className='text-muted'>{_('xoaHlScheduleLoading')}</p>
+    }
+    if (configuration === undefined) {
+      return <Banner icon='error' level='danger'>{_('xoaHlScheduleUnavailable')}</Banner>
+    }
+
+    const installationSelected = configuration.mode === 'install'
+    const lastResult = configuration.lastRun.result
+
+    return (
+      <div>
+        <p className='text-muted'>{_('xoaHlAutomaticUpdatesDisabled')}</p>
+        <Row>
+          <Col mediumSize={6}>
+            <label>{_('xoaHlMode')}</label>
+            <select className='form-control' disabled={configurationSaving} onChange={this._setConfigurationField('mode')} value={configuration.mode}>
+              <option value='manual'>{_('xoaHlModeManual')}</option>
+              <option value='check'>{_('xoaHlModeCheck')}</option>
+              <option value='install'>{_('xoaHlModeInstall')}</option>
+            </select>
+          </Col>
+          <Col mediumSize={6}>
+            <label>{_('xoaHlFrequency')}</label>
+            <select className='form-control' disabled={configurationSaving || configuration.mode === 'manual'} onChange={this._setConfigurationField('frequency')} value={configuration.frequency}>
+              <option value='daily'>{_('xoaHlFrequencyDaily')}</option>
+              <option value='weekly'>{_('xoaHlFrequencyWeekly')}</option>
+            </select>
+          </Col>
+        </Row>
+        <Row className='mt-1'>
+          <Col mediumSize={4}>
+            <label>{_('xoaHlDay')}</label>
+            <select className='form-control' disabled={configurationSaving || configuration.mode === 'manual' || configuration.frequency !== 'weekly'} onChange={this._setConfigurationField('day')} value={configuration.day}>
+              {['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map(day => <option key={day} value={day}>{day}</option>)}
+            </select>
+          </Col>
+          <Col mediumSize={4}>
+            <label>{_('xoaHlTime')}</label>
+            <input className='form-control' disabled={configurationSaving || configuration.mode === 'manual'} onChange={this._setConfigurationField('time')} type='time' value={configuration.time} />
+          </Col>
+          <Col mediumSize={4}>
+            <label>{_('xoaHlRandomDelay')}</label>
+            <select className='form-control' disabled={configurationSaving || configuration.mode === 'manual'} onChange={this._setConfigurationField('randomDelayMinutes')} value={configuration.randomDelayMinutes}>
+              {[0, 5, 10, 15, 30, 60].map(minutes => <option key={minutes} value={minutes}>{minutes} min</option>)}
+            </select>
+          </Col>
+        </Row>
+        <p className='mt-1 mb-1 text-muted'>
+          {_('xoaHlTimezone')}: {configuration.timezone}
+          {configuration.nextRun !== undefined && <span> · {_('xoaHlNextRun')}: {configuration.nextRun}</span>}
+        </p>
+        {lastResult === undefined ? (
+          <p className='text-muted'>{_('xoaHlNoAutomaticRun')}</p>
+        ) : (
+          <p className='text-muted'>
+            {_('xoaHlLastAutomaticResult')}: {lastResult}
+            {configuration.lastRun.finishedAt !== undefined && <span> · {configuration.lastRun.finishedAt}</span>}
+          </p>
+        )}
+        {installationSelected && (
+          <div>
+            <Banner icon='alarm' level='warning'>{_('xoaHlUpdateScope')}</Banner>
+            <label>
+              <input checked={automaticInstallConfirmed} disabled={configurationSaving} onChange={event => this.setState({ automaticInstallConfirmed: event.target.checked })} type='checkbox' />{' '}
+              {_('xoaHlAutomaticUpdatesConfirm')}
+            </label>
+          </div>
+        )}
+        <div className='mt-1'>
+          <ActionButton btnStyle='primary' disabled={installationSelected && !automaticInstallConfirmed} handler={this._saveConfiguration} icon='save' pending={configurationSaving}>
+            {_('xoaHlSaveAutomaticUpdates')}
+          </ActionButton>
+        </div>
+      </div>
+    )
+  }
+
+  render() {
+    const { checking, status, updating, version } = this.state
+    const updateAvailable = status !== undefined && status.updateAvailable
+
+    return (
+      <Container>
+        <Row>
+          <Col>
+            <Card>
+              <CardHeader>
+                <Icon icon='upgrade' /> {_('xoaHlAppliance')}
+              </CardHeader>
+              <CardBlock>
+                <p>
+                  {_('xoaHlInstalledVersion')}:{' '}
+                  <span className='text-monospace'>{version !== undefined ? version : _('xoaHlUnknownVersion')}</span>
+                </p>
+                {this._renderStatus()}
+                <p className='text-muted'>
+                  <Icon icon='info' /> {_('xoaHlUpdateScope')}
+                </p>
+                <ActionButton
+                  btnStyle='info'
+                  disabled={updating}
+                  handler={this._checkForUpdate}
+                  icon='refresh'
+                  pending={checking}
+                >
+                  {_('xoaHlCheckForUpdate')}
+                </ActionButton>{' '}
+                <ActionButton
+                  btnStyle='success'
+                  disabled={!updateAvailable || checking}
+                  handler={this._startUpdate}
+                  icon='upgrade'
+                  pending={updating}
+                >
+                  {_('xoaHlStartUpdate')}
+                </ActionButton>
+              </CardBlock>
+            </Card>
+          </Col>
+        </Row>
+        {this._renderLog()}
+        <Row className='mt-1'>
+          <Col>
+            <Card>
+              <CardHeader>
+                <Icon icon='calendar' /> {_('xoaHlAutomaticUpdates')}
+              </CardHeader>
+              <CardBlock>{this._renderAutomaticUpdates()}</CardBlock>
+            </Card>
+          </Col>
+        </Row>
+      </Container>
+    )
+  }
+}
