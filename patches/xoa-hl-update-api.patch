+  clearTimeout(reconnectTimeout)
+
+  // One backoff at a time: a second one would find the client CONNECTING,
+  // fail its status check and schedule yet another.
+  if (connecting || reconnectStopped) {
+    return
+  }
+  connecting = true
+
+  xo.open(createBackoff()).then(
